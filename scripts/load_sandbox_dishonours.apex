":"Refer to customer","rc":"6","ps":"SCHEDULED","pm":"DR","fc":2.75,"pa":31.19,"sa":31.19,"sd":"2025-12-09","dd":"2025-12-05","ref":"30000007258","st":"D","id":"SCHEDULED2475855297"}]');
List<EzidebitAPI.Payment> payments = new List<EzidebitAPI.Payment>();
Set<String> refs = new Set<String>();
for (Object o : raw) {
    Map<String, Object> m = (Map<String, Object>) o;
    EzidebitAPI.Payment p = new EzidebitAPI.Payment();
    p.PaymentID = (String) m.get('id');
    p.PaymentStatus = (String) m.get('st');
    p.YourSystemReference = (String) m.get('ref');
    
    Date dd = m.get('dd') == null ? null : Date.valueOf((String) m.get('dd'));
    Date sd = m.get('sd') == null ? null : Date.valueOf((String) m.get('sd'));
    p.DebitDate = dd == null ? null : Datetime.newInstance(dd.year(), dd.month(), dd.day());
    p.SettlementDate = sd == null ? null : Datetime.newInstance(sd.year(), sd.month(), sd.day());
    p.ScheduledAmount = m.get('sa') == null ? null : ((Decimal) m.get('sa')).doubleValue();
    p.PaymentAmount = m.get('pa') == null ? null : ((Decimal) m.get('pa')).doubleValue();
    p.TransactionFeeClient = m.get('fc') == null ? null : ((Decimal) m.get('fc')).doubleValue();
    p.TransactionFeeCustomer = 0;
    p.PaymentMethod = (String) m.get('pm');
    p.PaymentSource = (String) m.get('ps');
    p.BankReturnCode = (String) m.get('rc');
    p.BankFailedReason = (String) m.get('rs');
    payments.add(p);
    refs.add(p.YourSystemReference);
}
Map<String, String> terByRef = new Map<String, String>();
for (Opportunity o : [SELECT Contract_No__c, Account.Territory_Number__r.Short_Name__c FROM Opportunity WHERE Contract_No__c IN :refs]) {
    terByRef.put(o.Contract_No__c, o.Account.Territory_Number__r.Short_Name__c);
}
Map<String, String> territoryByPaymentId = new Map<String, String>();
for (EzidebitAPI.Payment p : payments) {
    territoryByPaymentId.put(p.PaymentID, terByRef.get(p.YourSystemReference));
}
EzidebitDishonourService.CaptureOptions opts = new EzidebitDishonourService.CaptureOptions();
opts.backfill = true;
opts.activeOnly = true;
EzidebitDishonourService.Result r = EzidebitDishonourService.capture(payments, territoryByPaymentId, opts);
Integer recovered = EzidebitDishonourService.recordRecoveries(payments);
Integer recoveredFromSf = EzidebitDishonourService.recoverFromPayments([
    SELECT Id, Opportunity__c, Debit_Date__c, Payment_Amount__c FROM Ezidebit_Dishonour__c
    WHERE Is_Backfill__c = true AND Type__c = 'Instalment' AND Outcome__c = 'Open' AND Opportunity__c != null]);
List<Fee__c> fees = [SELECT Id, Agreement__c, Fee_Type__c, Fee_Amount__c, Fee_Charged_Date__c, Ezidebit_Dishonour__c FROM Fee__c
    WHERE Agreement__r.Contract_No__c IN :refs AND Fee_Type__c = 'Late Payment' AND Ezidebit_Dishonour__c = null ORDER BY Fee_Charged_Date__c];
EzidebitDishonourService.linkFees(fees);
System.debug('LOADRESULT inserted=' + r.inserted + ' updated=' + r.updated + ' skippedInactive=' + r.skippedInactive
    + ' recoveredByEzidebit=' + recovered + ' recoveredFromSalesforce=' + recoveredFromSf + ' feesConsidered=' + fees.size());
