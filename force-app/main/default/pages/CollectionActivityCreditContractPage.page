<div class="col-5">

<div style="width:auto;height:300px;display:none;" id="map"></div>
<div style="width:auto;height:100px;display:none;" id="noLocation">
<apex:outputPanel rendered="{!IF(shortLinkOpenedDatetime!=null && shortLinkOpenedDatetime!='',true,false)}">
<b>Location access not provided by the customer</b><br/>
<b>Date Opened:</b> {!shortLinkOpenedDatetime} <br/> 
<b>Payment:</b> {!collectionActivity.Payment_Status__c} <br/>
<span style="display:{!IF(CONTAINS(collectedDeviceName,'null'),'none;','')}" ><b>Device Name:</b> {!collectedDeviceName}</span>
</apex:outputPanel>
<apex:outputPanel rendered="{!IF(shortLinkOpenedDatetime!=null && shortLinkOpenedDatetime!='',false,true)}">
<b>Short Link has not been opened yet</b>
</apex:outputPanel>
