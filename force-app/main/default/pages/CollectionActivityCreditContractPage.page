else
{    
    //$('#map').css({'height' : '50px', 'font-weight' : 'bold'});
    //$('#map').text('Location access not provided by the customer');
    $('#map').css({'display' : 'none'});
    $('#noLocation').css({'display' : ''});
}
}


function editReferee(elem)
{
    var index = $(elem).closest('tr').index();
    var refereeData = JSON.parse('{!refereesJSON}');
    
    $('.editRefereeId').val('');
    $('.editRefereeContactId').val('');
    $('#editRefereeName').html('');
    $('.editRefereePhone').val('');
    $('.editRefereeEmail').val('');
    
    $('.editRefereeId').val(refereeData[index-1].referee.Id);
    $('.editRefereeContactId').val(refereeData[index-1].referee.Referee_Name__c);
    $('#editRefereeName').html(refereeData[index-1].referee.Referee_Name__r.Name);
    $('.editRefereePhone').val(refereeData[index-1].referee.Referee_Name__r.MobilePhone);
    $('.editRefereeEmail').val(refereeData[index-1].referee.Email__c);
    $('.editRefereeContacted').val(refereeData[index-1].referee.Contacted__c == null || refereeData[index-1].referee.Contacted__c == undefined || refereeData[index-1].referee.Contacted__c.trim() !== 'Yes' ? 'No' : 'Yes');
    $('.editRefereeContactedDate').val('');
    
    if(refereeData[index-1].referee.Contacted_On_Date__c != undefined)
    {
        var paymentDate = new Date(refereeData[index-1].referee.Contacted_On_Date__c);
        var formatted_PaymentDate = (paymentDate.getDate() < 10 ? "0" : "") + paymentDate.getDate() + "/" + (paymentDate.getMonth() < 9 ? "0" : "") + parseInt(paymentDate.getMonth() + 1) + "/" + paymentDate.getFullYear();
        $('.editRefereeContactedDate').val(formatted_PaymentDate);
    }
    
    $('#refereeModal').modal('show');
}

function validateArrangement()
{
    if($('.staEndDate').val() != '' && !checkdate($('.staEndDate').val()))
    {
        alert('Invalid STA End Date. Please correct and submit again.');
        return false;
    }
    
    if($('.staDueDate').val() != '' && !checkdate($('.staDueDate').val()))
    {
        alert("Invalid STA Next Due Date. Please correct and submit again.");
        return false;
    }

    if($('.isThisSTA').prop('checked'))
    {   
        if($('.staEndDate').val() == '' || ($('.staEndDate').val() != '' && (!checkdate($('.staEndDate').val()) || !isFutureDate($('.staEndDate').val()))))
        {
            alert('Invalid STA End Date. Please correct and submit again.');
            return false;
        }
        
        if($('.staDueDate').val() == '' || ($('.staDueDate').val() != '' && (!checkdate($('.staDueDate').val()) || !isFutureDate($('.staDueDate').val()))))
        {
            alert("Invalid STA Next Due Date. Please correct and submit again.");
            return false;
        }

        if($('.staNotes').val() == '')
        {
            alert("Please enter STA Notes.");
            return false;
        }

        if($('.staAmount').val() == '' || parseFloat($('.staAmount').val()) <= 0)
        {
            alert("Please enter STA Scheduled Amount.");
            return false;
        }
    }
}

function isFutureDate(dateString) {
    // Split the input date string by '/'
    const [day, month, year] = dateString.split('/').map(Number);
    
    // Create a Date object from the input date
    const inputDate = new Date(year, month - 1, day);
    
    // Get the current date
    const currentDate = new Date();
    
    // Set the time of the current date to 00:00:00 to compare only the date part
    currentDate.setHours(0, 0, 0, 0);
    
    // Return true if the input date is greater than the current date
    return inputDate >= currentDate;
}

function checkdate(dateInput)
{
    var validformat = /^([0-9]{1,2})\/([0-9]{1,2})\/([0-9]{4})$/;
    
    if(!validformat.test(dateInput))
    {
        return false;
    }
    else
    { 
        //Detailed check for valid date ranges
        var monthfield = parseInt(dateInput.split("/")[1]);
        var dayfield = parseInt(dateInput.split("/")[0]);
        var yearfield = parseInt(dateInput.split("/")[2]);
        var dayobj = new Date(yearfield, monthfield-1, dayfield);
        
        if((dayobj.getMonth()+1 != monthfield) || (dayobj.getDate() != dayfield) || (dayobj.getFullYear() != yearfield))
        {
            return false;
        }
        
        console.log(dayfield);
        console.log(dayobj.getDate());
        console.log(monthfield);
        console.log(dayobj.getMonth()+1);
        console.log(yearfield);
        console.log(dayobj.getFullYear());
    }
    return true;
}
