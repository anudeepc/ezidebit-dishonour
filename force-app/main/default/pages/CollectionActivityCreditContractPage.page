<div class="btn-group d-flex mt-1 mb-1" role="group" aria-label="Basic example">
  <a class="btn btn-sm btn-primary text-white w-100" data-toggle="modal" data-target="#actionModal">Action</a>
  <a class="btn btn-sm btn-primary text-white w-100" data-toggle="modal" data-target="#smsModal" onclick="updateSMSText('SMS');">SMS</a>
  <a class="btn btn-sm btn-primary text-white w-100" data-toggle="modal" data-target="#emailModal">Email</a>
  <a class="btn btn-sm btn-primary text-white w-100" data-toggle="modal" data-target="#feesModal">Fees</a>
  <a class="btn btn-sm btn-primary text-white w-100" data-toggle="modal" data-target="#fieldModal" onclick="initFieldVisit();">Field Visit</a>
  <a class="btn btn-sm btn-primary text-white w-100" data-toggle="modal" data-target="#arrangementModal">Arrangement</a>
</div>

<div class="mt-1 mb-1">
<table class="table table-sm">
    <tbody>
        <tr>
            <td width="30%"><strong>Payment Link</strong></td>
            <td width="70%"><a href="{!collectionActivity.Short_Link__c}" target="_blank">{!collectionActivity.Short_Link__c}</a></td>
        </tr>
        <tr>
            <td><strong>Payment Status</strong></td>
            <td>{!collectionActivity.Payment_Status__c}</td>
        </tr>
        <tr>
            <td><strong>DOB</strong></td>
            <td><apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!opportunity.Account.Birthdate__c}"/></apex:outputText></td>
        </tr>
        <tr>
            <td><strong>Address</strong></td>
            <td>{!opportunity.Account.UnformattedAddress_VedaAlert_Report__c}</td>
        </tr>
    </tbody>
</table>
</div>
<div style="max-height:550px;overflow:auto;">
<table class="table table-sm">
    <thead class="bg-secondary text-center text-white">
        <th colspan="6">Notes</th>
    </thead>
    <tbody style="background-color: #F2F3F4;">
