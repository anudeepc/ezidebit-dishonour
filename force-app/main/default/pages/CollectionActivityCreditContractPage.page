                               <apex:selectOption itemValue="Direct Contact" itemLabel="Direct Contact"/>
                               <apex:selectOption itemValue="SMS" itemLabel="SMS"/>
                               <apex:selectOption itemValue="Email" itemLabel="Email"/>
                               <apex:selectOption itemValue="Repetitive Calls" itemLabel="Repetitive Calls"/>
