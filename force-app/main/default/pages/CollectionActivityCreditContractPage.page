<apex:page standardController="Collection_Activity__c" standardstylesheets="false" sidebar="false" showHeader="false" extensions="CollectionsConsoleCreditContract,CollectionDishonourPanel" action="{!initializeConsole}">

<!-- CSS files-->
<apex:stylesheet value="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css"/>
<apex:stylesheet value="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.css"/>
<!-- End of CSS files-->

<!-- JS files -->
<apex:includeScript value="https://code.jquery.com/jquery-3.3.1.js"/>
<apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.js"/>
<apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js"/>
<apex:includeScript value="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"/>
<apex:includeScript value="https://www.gstatic.com/charts/loader.js"/>
<!-- End of JS files -->

<title>{!Collection_Activity__c.Name}</title>

<style>

.chart {
  width: 100%; 
  min-height: 450px;
}
.row {
  margin:0 !important;
}

.dsh-strip { border-left:6px solid #6c757d; background:#f8f9fa; margin:8px 15px 0 15px; padding:8px 10px; font-size:13px; }
.dsh-strip.dsh-danger { border-left-color:#c62828; background:#fdecea; }
.dsh-strip.dsh-warning { border-left-color:#ef8c00; background:#fff4e5; }
.dsh-strip.dsh-success { border-left-color:#2e7d32; background:#edf7ed; }
.dsh-tile { padding:2px 12px 2px 0; }
.dsh-tile .dsh-label { color:#5f6368; font-size:11px; text-transform:uppercase; letter-spacing:.03em; }
.dsh-tile .dsh-value { font-size:15px; font-weight:600; }
.dsh-tile .dsh-sub { font-size:12px; color:#3c4043; }
.dsh-text-danger { color:#c62828; }
.dsh-text-warning { color:#b26a00; }
.dsh-text-success { color:#2e7d32; }
.dsh-text-secondary { color:#5f6368; }
.dsh-legend span { display:inline-block; margin-right:12px; font-size:12px; }
.dsh-legend i { display:inline-block; width:10px; height:10px; margin-right:4px; border-radius:2px; vertical-align:middle; }
.container-fluid
{
    margin-left: 0px;
    margin-right: 0px;
    padding-left: 0px;
    padding-right: 0px;
}

</style>

<apex:form >

<apex:messages />

<div class="container-fluid">

<!-- CA Header -->

<nav class="navbar navbar-expand-lg navbar-light bg-info text-white sticky-top">
<div class="collapse navbar-collapse" id="navbarNavDropdown">
    <ul class="navbar-nav ml-auto w-100 justify-content-center">
        <li class="nav-item w-25 pt-2 pb-2">
           <a style="color:white;" href="/{!currentCollectionActivity.Id}" target="_blank"><strong>{!currentCollectionActivity.Name}</strong></a>
        </li>
        <li class="nav-item w-50  pt-2 pb-2">
           <a style="color:white;" href="/{!opportunity.Id}" target="_blank"><strong>{!opportunity.Name}</strong></a>
        </li>
        <li class="nav-item w-25  pt-2 pb-2">
           <a><strong>{!opportunity.Contract_No__c}</strong></a>
        </li>
        <li class="nav-item w-25  pt-2 pb-2">
           <a><strong>{!opportunity.Account.Centrepay_Ref_No__c}</strong></a>
        </li>
        <li class="nav-item w-25  pt-2 pb-2">
           <strong><a  style="color:white;" href="tel:+{!opportunity.Account.SMS_Mobile__c}">{!opportunity.Account.SMS_Mobile__c}</a></strong>
        </li>
        <li class="nav-item w-25  pt-2 pb-2">
           <a><strong>{!currentCollectionActivity.Activity_Type__c}</strong></a>
        </li>
        <li class="nav-item w-25  pt-2 pb-2">
           <apex:outputText rendered="{!opportunity.Account.Is_IDR__c}"><strong>IDR</strong></apex:outputText>
        </li>
        <li class="nav-item w-25  pt-2 pb-2">
           <a><strong>{!LEFT(currentCollectionActivity.Next_Step__c,20)}</strong></a>
        </li>
    </ul>
</div>
</nav>


<!-- CA Header --> 

<!-- Ezidebit dishonours summary (CollectionDishonourPanel) -->
<apex:outputPanel layout="none" rendered="{!dshHasAgreement}">
<div class="dsh-strip dsh-{!IF(dshHasAccess, dshTone, 'secondary')}">
<apex:outputPanel layout="none" rendered="{!!dshHasAccess}">
    Ezidebit dishonours are hidden: ask your Salesforce admin for the "Ezidebit Dishonour Access" permission set.
</apex:outputPanel>
<apex:outputPanel layout="none" rendered="{!dshHasAccess}">
<div class="d-flex flex-wrap">
    <div class="dsh-tile">
        <div class="dsh-label">Last failed debit</div>
        <apex:outputPanel layout="none" rendered="{!dshLast != null}">
            <div class="dsh-value"><apex:outputText value="{0,date,EEE d MMM yyyy}"><apex:param value="{!dshLast.Debit_Date__c}"/></apex:outputText>&nbsp;&middot;&nbsp;<apex:outputText value="{0,number,currency}"><apex:param value="{!dshLast.Payment_Amount__c}"/></apex:outputText></div>
            <div class="dsh-sub">{!dshLast.Type__c}: {!dshLastReason}</div>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!dshLast == null}"><div class="dsh-value dsh-text-success">None recorded</div></apex:outputPanel>
    </div>
    <div class="dsh-tile">
        <div class="dsh-label">Automatic retry</div>
        <div class="dsh-value dsh-text-{!dshRetryTone}">{!dshRetryStatus}</div>
    </div>
    <div class="dsh-tile">
        <div class="dsh-label">Unrecovered, last 60 days</div>
        <div class="dsh-value {!IF(dshUnrecoveredCount > 0, 'dsh-text-danger', 'dsh-text-success')}">{!dshUnrecoveredCount}&nbsp;&middot;&nbsp;<apex:outputText value="{0,number,currency}"><apex:param value="{!dshUnrecoveredAmount}"/></apex:outputText></div>
    </div>
    <apex:outputPanel layout="none" rendered="{!dshDebitsStopped}">
    <div class="dsh-tile">
        <div class="dsh-label">Ezidebit</div>
        <div class="dsh-value dsh-text-danger">Debits stopped&nbsp;<apex:outputText value="{0,date,d MMM}"><apex:param value="{!dshDebitsStoppedDate}"/></apex:outputText></div>
        <div class="dsh-sub">No more debits until the customer's details are fixed</div>
    </div>
    </apex:outputPanel>
    <div class="dsh-tile">
        <div class="dsh-label">DD default notice (Form 11A)</div>
        <div class="dsh-value">{!dshNoticeStatus}</div>
    </div>
    <div class="dsh-tile">
        <div class="dsh-label">Failures, last 12 months</div>
        <div class="dsh-value">{!dshFailures12m}</div>
        <div class="dsh-sub">Ezidebit fees&nbsp;<apex:outputText value="{0,number,currency}"><apex:param value="{!dshEzidebitFees12m}"/></apex:outputText>&nbsp;&middot; R4K fees&nbsp;<apex:outputText value="{0,number,currency}"><apex:param value="{!dshR4kFees12m}"/></apex:outputText></div>
    </div>
</div>
</apex:outputPanel>
<div class="d-flex flex-wrap" style="margin-top:6px;border-top:1px solid rgba(0,0,0,.08);padding-top:6px;">
    <apex:outputPanel layout="none" rendered="{!dshHardshipStatus != null}">
    <div class="dsh-tile">
        <div class="dsh-label">Hardship request</div>
        <div class="dsh-value dsh-text-{!dshHardshipTone}">{!dshHardshipStatus}</div>
        <div class="dsh-sub">Collections contact is on hold while a request is open (IDR)</div>
    </div>
    </apex:outputPanel>
    <apex:outputPanel layout="none" rendered="{!dshArrangement != null}">
    <div class="dsh-tile">
        <div class="dsh-label">Payment arrangement</div>
        <div class="dsh-value dsh-text-{!dshArrangementTone}">{!dshArrangement.status}<apex:outputText rendered="{!dshArrangement.shortfall > 0}">&nbsp;&middot;&nbsp;<apex:outputText value="{0,number,currency}"><apex:param value="{!dshArrangement.shortfall}"/></apex:outputText> behind</apex:outputText></div>
        <div class="dsh-sub">{!dshArrangement.summary}</div>
    </div>
    </apex:outputPanel>
    <apex:outputPanel layout="none" rendered="{!dshOpp.Interest_Stopped_From__c != null}">
    <div class="dsh-tile">
        <div class="dsh-label">Interest</div>
        <div class="dsh-value dsh-text-warning">Stopped from&nbsp;<apex:outputText value="{0,date,d MMM yyyy}"><apex:param value="{!dshOpp.Interest_Stopped_From__c}"/></apex:outputText></div>
        <div class="dsh-sub">{!dshOpp.Interest_Stop_Reason__c}</div>
    </div>
    </apex:outputPanel>
    <div class="dsh-tile ml-auto" style="align-self:center;">
        <a class="btn btn-sm btn-outline-dark" href="{!dshPayoutStatementUrl}" target="_blank">Payout statement</a>
        <a class="btn btn-sm btn-outline-dark" href="{!dshAgreementStatementUrl}" target="_blank">Agreement statement</a>
        <apex:commandButton styleClass="btn btn-sm btn-outline-dark" value="Email statement" action="{!dshSendStatement}"
            onclick="return confirm('Email the agreement statement to {!JSENCODE(IF(ISBLANK(dshOpp.Account.PersonEmail), 'nobody (no email on file: it will be saved for posting)', dshOpp.Account.PersonEmail))}?');"/>
        <apex:outputPanel layout="none" rendered="{!dshHardshipAccess}">
            <a class="btn btn-sm btn-outline-dark" href="{!dshNewHardshipUrl}" target="_blank">Log hardship request</a>
        </apex:outputPanel>
        <a class="btn btn-sm btn-outline-danger" href="/apex/InterestStop?oppId={!dshOpp.Id}" target="_blank">{!IF(dshOpp.Interest_Stopped_From__c != null, 'Interest stop', 'Stop interest')}</a>
    </div>
</div>
</div>
</apex:outputPanel>

<div class="row mt-2" style="font-size:14px;">

<!-- Left Div -->
<div class="col-7">

<div class="row">

<table class="table table-sm text-center" id="applicantTable1">
    <tbody>
        <tr>
            <td>Loan Amount</td>
            <td>TAV</td>
            <td>Total Paid</td>
        </tr>
        <tr>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Total_Loan_Amount__c}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Amount}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Total_Paid_Amount__c}"/></apex:outputText></td>
        </tr>
        <tr>
            <td>Total Paid Prinicipal Amount</td>
            <td>Total Loan Balance Amount</td>
            <td>Total Loan Amount Incl Unpaid Interest</td>
        </tr>
        <tr>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Total_Paid_Principal_Amount__c}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Total_Loan_Balance_Amount__c}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Total_Loan_Amount_Incl_Unpaid_Interest__c}"/></apex:outputText></td>
        </tr>
        <tr>
            <td>Rem. Amount</td>
            <td>Sched. Amount</td>
            <td>Payment Frequency</td>
        </tr>
        <tr>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Remaining_Amount__c}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!Opportunity.Scheduled_Amount__c}"/></apex:outputText></td>
            <td class="h5">{!Opportunity.Payment_Frequency__c}</td>
        </tr>      
    </tbody>
</table>

<table class="table table-sm text-center" id="applicantTable2" style="background-color: #dfe0e0;">
    <tbody>
        <tr>
            <td>Arrears Original</td>
            <td>Actual Arrears</td>
            <td>Missed Days</td>
        </tr>
        <tr>
            <td class="h5"><apex:outputText value="{0,number,currency}" style="color:{!IF(Opportunity.Actual_Arrears_Original__c > 0,'#D81E05','green')}"><apex:param value="{!Opportunity.Actual_Arrears_Original__c}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}" style="color:{!IF(Opportunity.Actual_Arrears__c > 0,'#D81E05','green')}"><apex:param value="{!Opportunity.Actual_Arrears__c}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{!IF(Opportunity.Days_Since_Expected_Payment__c > 0, Opportunity.Days_Since_Expected_Payment__c, 0)}" style="color:{!IF(Opportunity.Days_Since_Expected_Payment__c > 0, '#D81E05', 'green')}"/></td>
        </tr>
        <tr>
            <td>Late Fee</td>
            <td>Site Visit</td>
            <td>Termination</td>
        </tr>
        <tr>
            <td class="h5"><apex:outputText value="{0,number,currency}" style="color:{!IF(lateFees > 0,'#D81E05','green')}"><apex:param value="{!lateFees}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}" style="color:{!IF(siteVisitFees > 0,'#D81E05','green')}"><apex:param value="{!siteVisitFees}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}" style="color:{!IF(terminationFees > 0,'#D81E05','green')}"><apex:param value="{!terminationFees}"/></apex:outputText></td>
        </tr>      
    </tbody>
</table>

</div>  

<apex:outputPanel rendered="{!IF(opportunity.Account.WrittenOff_s_Count__c > 0, true, false)}">
<div class="row">

<table class="table table-sm text-center bg-danger text-white applicantTable3">
    <tbody>
        <tr>
            <td># Written Offs</td>
            <td>TAV</td>
            <td>Total Paid</td>
            <td>Rem. Amount</td>
            <td>Arrears Original</td>
            <td>Actual Arrears</td>
        </tr>
        <tr>
            <td class="h5">{!opportunity.Account.WrittenOff_s_Count__c}</td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!tavWrittenOff}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!totalPaidWrittenOff}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!remainingAmountWrittenOff}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!actualArrearsOriginalWrittenOff}"/></apex:outputText></td>
            <td class="h5"><apex:outputText value="{0,number,currency}"><apex:param value="{!actualArrearsWrittenOff}"/></apex:outputText></td>
        </tr>           
    </tbody>
</table>

</div>    
</apex:outputPanel>

<div class="row">

<div class="col-12" id="paymentsDiv">
     <div id="chart_div_dishonour_timeline"></div>
     <div class="dsh-legend text-center" id="dshLegend" style="display:none;">
        <span><i style="background:#2e7d32;"></i>Paid</span>
        <span><i style="background:#ef8c00;"></i>Failed, then recovered</span>
        <span><i style="background:#c62828;"></i>Failed, not recovered</span>
        <span><i style="background:#7f0000;"></i>Retry failed</span>
        <span><i style="background:#212121;"></i>Debits stopped</span>
        <span><i style="background:#6a1b9a;"></i>Taken back by bank</span>
     </div>
     <div id="chart_div_payment"></div>
    
</div>

</div>

<hr/>

