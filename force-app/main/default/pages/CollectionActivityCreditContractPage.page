var dshColours = { paid:'#2e7d32', recovered:'#ef8c00', failed:'#c62828', retryFailed:'#7f0000', stopped:'#212121', lateReturn:'#6a1b9a', card:'#9e9e9e' };

function drawPaymentCharts() {
    if (dshTimeline && dshTimeline.length > 0 && dshTimeline.some(function(e){ return e.kind != 'paid'; })) {
        drawDishonourTimeline();
        document.getElementById('chart_div_payment').style.display = 'none';
    } else {
        drawBasicPayment();
    }
}

function drawDishonourTimeline() {
    const months = ["Jan", "Feb", "Mar","Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var scheduled = parseFloat("{!Opportunity.Scheduled_Amount__c}");
    var dataTable = new google.visualization.DataTable();
    dataTable.addColumn('string', 'Date');
    dataTable.addColumn('number', 'Amount');
    dataTable.addColumn({type:'string', role:'style'});
    dataTable.addColumn({type:'string', role:'annotation'});
    dataTable.addColumn({type:'string', role:'tooltip'});
    dataTable.addColumn('number', 'Scheduled amount');
    var amounts = dshTimeline.map(function(e){ return parseFloat(e.amount) || 0; }).sort(function(a, b){ return a - b; });
    var typical = amounts[Math.floor(amounts.length / 2)] || 0;
    var cap = Math.max(isNaN(scheduled) ? 0 : scheduled, typical) * 4;
    var clipped = amounts[amounts.length - 1] > cap && cap > 0;
    for (var i = 0; i < dshTimeline.length; i++) {
        var e = dshTimeline[i];
        var parts = e.day.split('-');
        var label = parseInt(parts[2], 10) + ' ' + months[parseInt(parts[1], 10) - 1];
        var amount = parseFloat(e.amount);
        // Colours and the legend carry the outcome; only a clipped bar gets a label, with its real amount.
        var note = clipped && amount > cap ? '$' + Math.round(amount).toLocaleString() + ' \u2191' : null;
        dataTable.addRow([label, clipped ? Math.min(amount, cap) : amount, dshColours[e.kind] || '#9e9e9e', note,
            label + ' ' + parts[0] + '\n' + e.label + ': $' + amount.toFixed(2) + (e.detail ? '\n' + e.detail : ''),
            isNaN(scheduled) ? null : scheduled]);
    }
    var options = {
        title: 'Payments and failed debits, by the date they happened',
        hAxis: { slantedText: true, slantedTextAngle: 45 },
        vAxis: { title: 'Amount ($)', minValue: 0, viewWindow: clipped ? { min: 0, max: cap } : { min: 0 } },
        legend: { position: 'none' },
        seriesType: 'bars',
        series: { 1: { type: 'line', color: '#adb7c1', lineDashStyle: [4, 4] } },
        annotations: { textStyle: { fontSize: 10 } },
        chartArea: { left: 60, right: 20, top: 40, bottom: 70 },
        height: 320
    };
    new google.visualization.ComboChart(document.getElementById('chart_div_dishonour_timeline')).draw(dataTable, options);
    document.getElementById('dshLegend').style.display = 'block';
}

function drawBasicPayment() {

    var json = '{!paymentJson}';
    //alert(json);
    
    if(json != 'null' && json != '')
    {
        var records = JSON.parse(json);
        var appScheduledAmount = parseFloat("{!Collection_Activity__c.Applicant__r.Schedule_Amount__c}");
        const months = ["Jan", "Feb", "Mar","Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        //alert(appScheduledAmount);
        
        var dataTable = new google.visualization.DataTable();
        dataTable.addColumn('string','Payment Date');
        dataTable.addColumn('number','Payment Amount');
        dataTable.addColumn({type:'string', role:'style'});
        dataTable.addColumn({type:'string', role:'annotation'});
        dataTable.addColumn('number','Scheduled Amount');
        dataTable.addColumn({type:'string', role:'style'});
        dataTable.addColumn({type:'string', role:'annotation'});
        var dataValue='';
        
        for(var i =0; i<records.length;i++)
        {
            var payment = records[i];
            var paymentDate = new Date(payment.CreatedDate);
            var formatted_PaymentDate = paymentDate.getDate() + "-" + months[paymentDate.getMonth()] + "-" + paymentDate.getFullYear();
            var paymentAmount = parseFloat(payment.Total_Paid__c);
            var paymentType = payment.RecordType.Name;
            var paymentColorIndicator=paymentAmount>=appScheduledAmount ? "#8BCB78": "#FF6384";
            //alert(paymentDate+" "+paymentAmount+" "+paymentType);
            
            dataValue =[];
            dataValue.push(formatted_PaymentDate);
            dataValue.push(paymentAmount);
            dataValue.push(paymentColorIndicator);
            dataValue.push(paymentType);
            dataValue.push(appScheduledAmount);
            dataValue.push("#ADB7C1");
            
            if(i < records.length - 1)
            {
                var date1 = new Date(records[i].CreatedDate);            
                var date2 = new Date(records[i+1].CreatedDate);
                var diffTime = Math.abs(date1.getTime() - date2.getTime());
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
                dataValue.push(diffDays - 1 + ' days');
            }else{
                dataValue.push(0 + ' days');
            }
            
            if(i < 6)
            {
                dataTable.addRow(dataValue);
            }
        } 
        
        var options = {
        title: 'Last 6 Payment Trend',
        hAxis: {
          title: 'Payment Uploaded Date',
          format: 'dd/MM/YYYY',
        },
        vAxis: {
          title: 'Payment Amount ($)'
        },
        legend: { position: "none" },
        seriesType: 'bars',
        series: {4: {type: 'line'}},
        animation: {
          startup: true,
          duration: 1500,
          easing: 'out',
         }
        };
        
        var chart = new google.visualization.ComboChart(
        document.getElementById('chart_div_payment'));
        
        chart.draw(dataTable, options);
    }
}

