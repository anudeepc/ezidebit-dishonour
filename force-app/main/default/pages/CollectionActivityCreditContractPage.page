                    <tr style="display:none;" class="paymentAmountRow"><td>Payment Amount</td><td><apex:inputText value="{!paymentAmount}" styleclass="form-control paymentAmount"/></td></tr>
                    <tr style="display:none;" class="paymentTypeRow">
