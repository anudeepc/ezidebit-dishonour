                    <tr><td>Contacted Customer On</td><td><apex:inputText styleClass="customerContactedDateTime" value="{!customerContactedDateTime}" onclick="$(this).datepicker({ dateFormat: 'dd/mm/yy' });$(this).datepicker('show');"/></td></tr>
