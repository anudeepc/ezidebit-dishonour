                               <apex:selectOption itemValue="Contacted" itemLabel="Contacted"/>
                               <apex:selectOption itemValue="Disconnected" itemLabel="Disconnected"/>
                               <apex:selectOption itemValue="Mailbox Full" itemLabel="Mailbox Full"/>
                               <apex:selectOption itemValue="No Answer" itemLabel="No Answer"/>
                               <apex:selectOption itemValue="Left Message" itemLabel="Left Message"/>
