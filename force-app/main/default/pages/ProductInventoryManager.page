        function saveWebsiteTerms() {
            const p13 = document.getElementById('term13').checked;
            const p24 = document.getElementById('term24').checked;
            const p36 = document.getElementById('term36').checked;

            if (!p13 && !p24 && !p36) {
                showNotification('error', 'Choose at least one term. To remove a product from sale entirely, use Out of Stock.');
                return;
            }

            const pushNow = document.getElementById('termsPushNow').checked;
            const useCategory = termsCategory && document.getElementById('termsApplyCategory').checked;
            const chosen = [p13 && '13', p24 && '24', p36 && '36'].filter(Boolean).join(', ');

            const scope = useCategory
                ? 'every product in ' + termsCategory
                : termsTargetIds.length + ' product' + (termsTargetIds.length === 1 ? '' : 's');

            if (!confirm('Offer ' + chosen + ' month terms on the website for ' + scope + '?'
                    + (pushNow ? '\n\nThe website will be updated now.' : '\n\nSaved in Salesforce only for now.'))) {
                return;
            }

            const btn = document.getElementById('termsSaveBtn');
            btn.disabled = true;
            showNotification('info', 'Setting contract terms...');

            const done = function(result, event) {
                btn.disabled = false;
                if (event.status && result.success) {
                    showNotification('success', result.message);
                    closeTermsEditor();
                    clearSelection();
                    showSyncLoadingAndRefresh(pushNow ? 4 : 1);
                } else {
                    showNotification('error', (result && result.message) || event.message || 'Unknown error');
                }
            };

            if (useCategory) {
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.ProductInventoryController.setWebsiteTermsForCategory}',
                    termsCategory, p13, p24, p36, pushNow, done,
                    {escape: true, timeout: 120000}
                );
            } else {
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.ProductInventoryController.setWebsiteTerms}',
                    termsTargetIds, p13, p24, p36, pushNow, done,
                    {escape: true, timeout: 120000}
                );
            }
        }

        // ---- Website reconciliation -------------------------------------------------------
        // Two named directions, never one ambiguous "sync". Salesforce holds the business's
        // intent; the website holds what customers can actually see. Which one is right is a
        // judgement call, so the operator makes it.

        function resolveFixWebsite(recordId) {
            if (!confirm('Push the Salesforce decision to the website?\n\nThe website will be changed to match Salesforce, and current pricing goes with it.')) {
                return;
            }
            showNotification('info', 'Updating the website to match Salesforce...');
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.resolveByFixingWebsite}',
                [recordId],
                function(result, event) {
                    if (event.status && result.success) {
                        showNotification('success', result.message);
                        showSyncLoadingAndRefresh(3);
                    } else {
                        showNotification('error', (result && result.message) || event.message || 'Unknown error');
                    }
                },
                {escape: true, timeout: 120000}
            );
        }

        function resolveAcceptWebsite(recordId, confirmOverride) {
            if (!confirmOverride &&
                !confirm('Accept the website as correct?\n\nSalesforce will be changed to match the website. Use this only when someone deliberately changed the product on the website.')) {
                return;
            }
            showNotification('info', 'Updating Salesforce to match the website...');
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.resolveByAcceptingWebsite}',
                [recordId], confirmOverride === true,
                function(result, event) {
                    if (event.status && result.success) {
                        showNotification('success', result.message);
                        showSyncLoadingAndRefresh(3);
                        return;
                    }
                    // The common refusal: Salesforce never confirmed telling the website about its
                    // decision, so the website's disagreement is ignorance rather than a competing
                    // decision. Overriding is allowed, but only as a second deliberate act.
                    var msg = (result && result.message) || event.message || 'Unknown error';
                    if (!confirmOverride && msg.indexOf('never confirmed') !== -1) {
                        if (confirm(msg + '\n\nOverride and accept the website anyway?')) {
                            resolveAcceptWebsite(recordId, true);
                            return;
                        }
                    }
                    showNotification('error', msg);
                },
                {escape: true, timeout: 120000}
            );
        }

