        // The two availability actions each apply to their own half of a mixed selection, so send
        // only the relevant ids. Without this, "Put Back On Sale" would post already-on-sale
        // products for the server to filter out, and the confirmation count would overstate what
        // actually changed.
        function selectedIdsByState(wantDisabled) {
            const ids = [];
            document.querySelectorAll('.product-checkbox:checked').forEach(cb => {
                if ((cb.getAttribute('data-disabled') === 'true') === wantDisabled) {
                    ids.push(cb.value);
                }
            });
            return ids;
        }

        // ---- Contract terms offered on the website ----------------------------------------
        // Which terms a customer is offered is a commercial decision, separate from what each term
        // costs. Unticking a term never touches its price: on the live theme a blanked price
        // advertised "$0.00 per week" and a deleted one made the theme invent its own figure, so
        // prices for hidden terms keep syncing and only the visibility instruction changes.

        var termsTargetIds = [];
        var termsCategory = null;

        // recordId null means "the current selection", which is how the bulk button calls it.
        function openTermsEditor(recordId) {
            const category = '{!JSENCODE(selectedCategory)}';

            if (recordId) {
                termsTargetIds = [recordId];
            } else {
                termsTargetIds = [];
                document.querySelectorAll('.product-checkbox:checked').forEach(cb => termsTargetIds.push(cb.value));
                if (termsTargetIds.length === 0 && (!category || category === 'All')) {
                    showNotification('error', 'Select some products first, or filter to a category to set terms for all of it');
                    return;
                }
            }

            // Whole-category application is only offered when the console is already filtered to
            // one, so the operator has seen the list they are about to change.
            termsCategory = (!recordId && category && category !== 'All') ? category : null;
            const categoryBlock = document.getElementById('termsCategoryBlock');
            if (termsCategory) {
                document.getElementById('termsCategoryName').textContent = termsCategory;
                document.getElementById('termsApplyCategory').checked = termsTargetIds.length === 0;
                categoryBlock.style.display = 'block';
                refreshTermsCategoryCount();
            } else {
                categoryBlock.style.display = 'none';
            }

            ['13', '24', '36'].forEach(t => {
                document.getElementById('termPrice' + t).textContent = '';
            });
            document.getElementById('termsUnreviewedNote').style.display = 'none';
            document.getElementById('termsMissingPrices').style.display = 'none';
            document.getElementById('termsPushNow').checked = true;

            if (recordId) {
                document.getElementById('termsScope').textContent = 'Loading...';
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.ProductInventoryController.getWebsiteTerms}',
                    recordId,
                    function(result, event) {
                        if (!event.status || !result.success) {
                            showNotification('error', (result && result.message) || event.message || 'Could not load terms');
                            closeTermsEditor();
                            return;
                        }
                        document.getElementById('termsScope').textContent = result.name + ' (' + result.recordName + ')';
                        document.getElementById('term13').checked = result.p13;
                        document.getElementById('term24').checked = result.p24;
                        document.getElementById('term36').checked = result.p36;
                        document.getElementById('termsUnreviewedNote').style.display = result.reviewed ? 'none' : 'block';
                        setTermPrice('13', result.price13);
                        setTermPrice('24', result.price24);
                        setTermPrice('36', result.price36);
                        if (result.missing) {
                            document.getElementById('termsMissingList').textContent = result.missing;
                            document.getElementById('termsMissingPrices').style.display = 'block';
                        }
                        refreshTermsWarning();
                        if (!result.mapped) {
                            showNotification('info', 'This product is not linked to the website yet, so the choice will be saved in Salesforce only');
                        }
                    },
                    {escape: true, timeout: 30000}
                );
            } else {
                // A mixed selection has no single current state to show, so start from the site
                // default rather than pre-ticking something that is only true for some rows.
                document.getElementById('term13').checked = false;
                document.getElementById('term24').checked = true;
                document.getElementById('term36').checked = true;
                refreshTermsWarning();
                updateTermsScopeText();
            }

            document.getElementById('termsOverlay').style.display = 'block';
            document.getElementById('termsModal').style.display = 'block';
        }

        // 13 months is calculated and pushed but commented out in the website code, so ticking it
        // records intent without the customer seeing anything. Say so rather than let staff think
        // it took effect.
        function refreshTermsWarning() {
            document.getElementById('terms13Warning').style.display =
                document.getElementById('term13').checked ? 'block' : 'none';
        }

        function setTermPrice(term, weekly) {
            const el = document.getElementById('termPrice' + term);
            el.textContent = (weekly === null || weekly === undefined)
                ? 'no price calculated yet'
