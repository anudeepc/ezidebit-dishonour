        function formatCurrency(value) {
            if (value == null || value == undefined) return '-';
            return '$' + parseFloat(value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
        }

        function formatDateTime(value) {
            if (!value) return '-';
            const date = new Date(value);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}`;
        }

        // Safe URL setter that avoids innerHTML XSS vulnerability
        function setSafeURL(elementId, url) {
            const element = document.getElementById(elementId);
            if (!element) return;

            // Clear existing content
            while (element.firstChild) {
                element.removeChild(element.firstChild);
            }

            if (!url) {
                element.textContent = '-';
                return;
            }

            // Create link element safely using DOM API
            const link = document.createElement('a');
            link.href = url; // Browser automatically sanitizes href
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'url-link';
            link.textContent = 'Open Link'; // Use textContent, not innerHTML
            element.appendChild(link);
        }

        // Deprecated - replaced with setSafeURL for security
        function formatURL(url) {
            if (!url) return '-';
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'url-link';
            link.textContent = 'Open Link';
            return link.outerHTML;
        }

        function validateForm() {
            const errors = [];

            // Validate prices are numbers (excluding cashPrice which is read-only/calculated)
            const priceFields = ['rrp', 'comp1Price', 'comp1NewPrice', 'comp2Price', 'comp2NewPrice', 'comp3Price', 'comp3NewPrice', 'sup1Price', 'sup2Price'];
            priceFields.forEach(fieldId => {
                const input = document.getElementById(fieldId);
                if (input && input.value && isNaN(parseFloat(input.value))) {
                    errors.push(fieldId + ' must be a valid number');
                }
            });

            // Validate URLs
            const urlFields = ['comp1URL', 'comp2URL', 'comp3URL', 'sup1URL', 'sup2URL'];
            urlFields.forEach(fieldId => {
                const input = document.getElementById(fieldId);
                if (input && input.value) {
                    try {
                        new URL(input.value);
                    } catch (e) {
                        errors.push(fieldId + ' must be a valid URL');
                    }
                }
            });

            return errors;
        }

        function saveChanges() {
            if (!currentRecordData) return;

            // Validate form
            const errors = validateForm();
            if (errors.length > 0) {
                showNotification('error', 'Validation errors: ' + errors.join(', '));
                return;
            }

            // Validate competitor names against blocked list (Big W, Office Works, Target)
            const comp1Name = getStringValue('comp1Name');
            const comp2Name = getStringValue('comp2Name');
            const comp3Name = getStringValue('comp3Name');

            const comp1Validation = validateCompetitorName(comp1Name);
            if (!comp1Validation.valid) {
                showNotification('error', 'Competitor 1: ' + comp1Validation.message);
                return;
            }

            const comp2Validation = validateCompetitorName(comp2Name);
            if (!comp2Validation.valid) {
                showNotification('error', 'Competitor 2: ' + comp2Validation.message);
                return;
            }

            const comp3Validation = validateCompetitorName(comp3Name);
            if (!comp3Validation.valid) {
                showNotification('error', 'Competitor 3: ' + comp3Validation.message);
                return;
            }

            // Show saving overlay
            document.getElementById('savingOverlay').classList.add('show');
            document.getElementById('saveBtn').disabled = true;

            // Collect updated data
            const updatedData = {
                Id: currentRecordData.Id,
                // Cash_Price__c is a formula field and cannot be updated
                RRP__c: getNumericValue('rrp'),
                Invoice_Cost__c: getNumericValue('invoiceCost'),
                Comments__c: getStringValue('priceExtractNotes'),
                Competitor_1__c: comp1Name,
                Competitor_1_Market_Value__c: getNumericValue('comp1Price'),
                Competitor_1_New_Market_Value__c: getNumericValue('comp1NewPrice'),
                Competitor_1_URL__c: getStringValue('comp1URL'),
                Competitor_1_URL_Notes__c: getStringValue('comp1Notes'),
                Competitor_2__c: comp2Name,
                Competitor_2_Market_Value__c: getNumericValue('comp2Price'),
                Competitor_2_New_Market_Value__c: getNumericValue('comp2NewPrice'),
                Competitor_2_URL__c: getStringValue('comp2URL'),
                Competitor_2_URL_Notes__c: getStringValue('comp2Notes'),
                Competitor_3__c: comp3Name,
                Competitor_3_Market_Value__c: getNumericValue('comp3Price'),
                Competitor_3_New_Market_Value__c: getNumericValue('comp3NewPrice'),
                Competitor_3_URL__c: getStringValue('comp3URL'),
                Competitor_3_URL_Notes__c: getStringValue('comp3Notes'),
                Supplier_1_Name__c: getStringValue('sup1Name'),
                Supplier_1_Price__c: getNumericValue('sup1Price'),
                Supplier_1_URL__c: getStringValue('sup1URL'),
                Supplier_2_Name__c: getStringValue('sup2Name'),
                Supplier_2_Price__c: getNumericValue('sup2Price'),
                Supplier_2_URL__c: getStringValue('sup2URL'),
                Delivery_Partner__c: getStringValue('deliveryPartner'),
                Delivery_Cost__c: getNumericValue('deliveryCost'),
                Regional_Delivery_Cost__c: getNumericValue('regionalDeliveryCost'),
                Supplier_Error_Notes__c: getStringValue('errorNotes')
            };

            // Call remote action
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.saveProductDetails}',
                updatedData,
                function(result, event) {
                    document.getElementById('savingOverlay').classList.remove('show');
                    document.getElementById('saveBtn').disabled = false;

                    if (event.status && result.success) {
                        showNotification('success', 'Changes saved successfully!');
                        hasUnsavedChanges = false;
                        clearModifiedFields();

                        // Update all cells in the row with new values
                        const recordId = updatedData.Id;
                        updateCompetitorCell(recordId, 1, updatedData.Competitor_1__c, updatedData.Competitor_1_Market_Value__c, updatedData.Competitor_1_URL__c, updatedData.Competitor_1_New_Market_Value__c);
