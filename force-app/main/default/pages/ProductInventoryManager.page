        // ========================================
        // Harvey Norman CSV Upload Functions (Client-side CSV parsing)
        // ========================================
        const HARVEY_CHUNK_SIZE = 200;
        const HARVEY_COL_PRODUCT_NAME = 4;  // Column E
        const HARVEY_COL_SKU = 6;           // Column G
        const HARVEY_COL_PRICE = 8;         // Column I
        const HARVEY_BASE_URL = 'https://www.harveynormanpromotions.com.au/';

        let harveyCsvContent = '';
        let harveyFileName = '';
        let harveyParsedRows = [];
        let harveyTotalRows = 0;
        let harveySentRows = 0;
        let harveyResults = { totalRows: 0, matchedCount: 0, updatedCount: 0, skippedCount: 0, errors: [], updatedProducts: [] };

        function openHarveyUploadModal() {
            document.getElementById('harveyModalOverlay').style.display = 'block';
            document.getElementById('harveyUploadModal').style.display = 'block';
            document.getElementById('harveyResults').style.display = 'none';
            document.getElementById('harveyCsvFile').value = '';
            document.getElementById('harveyFileName').textContent = '';
            document.getElementById('harveyFileSize').textContent = '';
            document.getElementById('harveyUploadBtn').disabled = true;
            harveyCsvContent = '';
            harveyFileName = '';
            harveyParsedRows = [];
        }

        function closeHarveyModal() {
            document.getElementById('harveyModalOverlay').style.display = 'none';
            document.getElementById('harveyUploadModal').style.display = 'none';
        }

        function handleHarveyFileSelect(input) {
            const file = input.files[0];
            if (!file) {
                document.getElementById('harveyFileName').textContent = '';
                document.getElementById('harveyFileSize').textContent = '';
                document.getElementById('harveyUploadBtn').disabled = true;
                harveyCsvContent = '';
                harveyFileName = '';
                return;
            }

            harveyFileName = file.name;
            document.getElementById('harveyFileName').textContent = 'Selected: ' + file.name;

            const fileSizeKB = Math.round(file.size / 1024);
            const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);
            document.getElementById('harveyFileSize').textContent =
                'Size: ' + (fileSizeKB > 1024 ? fileSizeMB + ' MB' : fileSizeKB + ' KB');

            const reader = new FileReader();
            reader.onload = function(e) {
                harveyCsvContent = e.target.result;
                document.getElementById('harveyUploadBtn').disabled = false;
            };
            reader.onerror = function() {
                alert('Error reading file');
                document.getElementById('harveyUploadBtn').disabled = true;
            };
            reader.readAsText(file);
        }

        function processHarveyUpload() {
            if (!harveyCsvContent) {
                alert('Please select a CSV file first');
                return;
            }

            const btn = document.getElementById('harveyUploadBtn');
            btn.disabled = true;
            btn.textContent = 'Parsing CSV...';

            // Reset state
            harveyParsedRows = [];
            harveySentRows = 0;
            harveyResults = { totalRows: 0, matchedCount: 0, updatedCount: 0, skippedCount: 0, errors: [], updatedProducts: [] };

            // Parse CSV client-side
            const rows = parseHarveyCsv(harveyCsvContent);
            if (rows.length < 2) {
                alert('CSV file is empty or invalid');
                btn.disabled = false;
                btn.textContent = 'Upload & Process';
                return;
            }

            // Find Comment column from header
            let commentColIndex = -1;
            const header = rows[0];
            for (let h = 0; h < header.length; h++) {
                const colName = cleanHarveyValue(header[h]).toLowerCase();
                if (colName === 'comment' || colName === 'comments' || colName === 'note' || colName === 'notes') {
                    commentColIndex = h;
                    break;
                }
            }

            // Extract data (skip header)
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                if (row.length > HARVEY_COL_PRICE) {
                    const sku = cleanHarveyValue(row[HARVEY_COL_SKU]);
                    const productName = cleanHarveyValue(row[HARVEY_COL_PRODUCT_NAME]);
                    const priceStr = cleanHarveyValue(row[HARVEY_COL_PRICE]);
                    const comment = commentColIndex >= 0 && row.length > commentColIndex ? cleanHarveyValue(row[commentColIndex]) : '';

                    if (sku) {
                        harveyParsedRows.push({
                            sku: sku.toUpperCase(),
                            productName: productName,
                            price: parseHarveyPrice(priceStr),
                            supplierUrl: generateHarveySupplierUrl(productName),
                            comment: comment
                        });
                    }
                }
            }

            harveyTotalRows = harveyParsedRows.length;
            harveyResults.totalRows = harveyTotalRows;

            if (harveyTotalRows === 0) {
                alert('No valid product data found in CSV');
                btn.disabled = false;
                btn.textContent = 'Upload & Process';
                return;
            }

            btn.textContent = 'Processing 0/' + harveyTotalRows + '...';
            sendHarveyNextChunk();
        }

        function sendHarveyNextChunk() {
            const btn = document.getElementById('harveyUploadBtn');

            if (harveySentRows >= harveyTotalRows) {
                // All done
                btn.disabled = false;
                btn.textContent = 'Upload & Process';
                displayHarveyResults(harveyResults);
                if (harveyResults.updatedCount > 0) {
                    refreshData();
                }
                return;
            }

            const chunk = harveyParsedRows.slice(harveySentRows, harveySentRows + HARVEY_CHUNK_SIZE);
            const chunkData = JSON.stringify(chunk);

            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.HarveySupplierUploadPageController.processChunk}',
                chunkData,
                function(result, event) {
                    if (event.status) {
                        harveySentRows += chunk.length;
                        harveyResults.matchedCount += result.matchedCount || 0;
                        harveyResults.updatedCount += result.updatedCount || 0;
                        harveyResults.skippedCount += result.skippedCount || 0;

                        if (result.errors && result.errors.length > 0) {
                            harveyResults.errors = harveyResults.errors.concat(result.errors);
                        }
                        if (result.updatedProducts && result.updatedProducts.length > 0) {
                            harveyResults.updatedProducts = harveyResults.updatedProducts.concat(result.updatedProducts);
                        }

                        btn.textContent = 'Processing ' + harveySentRows + '/' + harveyTotalRows + '...';
                        setTimeout(sendHarveyNextChunk, 50);
                    } else {
                        harveyResults.errors.push('Remoting error: ' + event.message);
                        harveySentRows += chunk.length;
                        setTimeout(sendHarveyNextChunk, 50);
                    }
                },
                { escape: false, timeout: 120000 }
            );
        }

        // CSV Parsing helper functions
        function parseHarveyCsv(content) {
            const lines = content.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
            const rows = [];
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                if (line.trim() === '') continue;
                rows.push(parseHarveyCsvLine(line));
            }
            return rows;
        }

        function parseHarveyCsvLine(line) {
            const values = [];
            let currentValue = '';
            let inQuotes = false;
            for (let i = 0; i < line.length; i++) {
                const c = line[i];
                if (c === '"') {
                    if (inQuotes && i + 1 < line.length && line[i + 1] === '"') {
                        currentValue += '"';
                        i++;
                    } else {
                        inQuotes = !inQuotes;
                    }
                } else if (c === ',' && !inQuotes) {
                    values.push(currentValue);
                    currentValue = '';
                } else {
                    currentValue += c;
                }
            }
            values.push(currentValue);
            return values;
        }

        function cleanHarveyValue(val) {
            if (!val) return '';
            val = val.trim();
            if (val.startsWith('"') && val.endsWith('"')) {
                val = val.substring(1, val.length - 1);
            }
            return val.trim();
        }

        function parseHarveyPrice(priceStr) {
            if (!priceStr) return null;
            const cleaned = priceStr.replace(/[^0-9.]/g, '');
            return cleaned ? parseFloat(cleaned) : null;
        }

        function generateHarveySupplierUrl(productName) {
            if (!productName) return '';
            let slug = productName.toLowerCase()
                .replace(/ - /g, '-')
                .replace(/ /g, '-')
                .replace(/[^a-z0-9-]/g, '')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
            return HARVEY_BASE_URL + slug + '.html';
        }

        function displayHarveyResults(result) {
            document.getElementById('harveyResults').style.display = 'block';
            document.getElementById('harveyTotalRows').textContent = result.totalRows || 0;
            document.getElementById('harveyMatched').textContent = result.matchedCount || 0;
            document.getElementById('harveyUpdated').textContent = result.updatedCount || 0;
            document.getElementById('harveySkipped').textContent = result.skippedCount || 0;

            const updatedList = document.getElementById('harveyUpdatedList');
            if (result.updatedProducts && result.updatedProducts.length > 0) {
                const displayList = result.updatedProducts.slice(0, 50);
                updatedList.innerHTML = '<strong>Updated Products (' + result.updatedProducts.length + ' total):</strong><ul style="margin: 8px 0 0 20px;">' +
                    displayList.map(p => '<li>' + p + '</li>').join('') +
                    (result.updatedProducts.length > 50 ? '<li>...and ' + (result.updatedProducts.length - 50) + ' more</li>' : '') +
                    '</ul>';
            } else {
                updatedList.innerHTML = '';
            }

            const errorList = document.getElementById('harveyErrorList');
            if (result.errors && result.errors.length > 0) {
                const displayErrors = result.errors.slice(0, 20);
                errorList.innerHTML = '<strong>Errors (' + result.errors.length + ' total):</strong><ul style="margin: 8px 0 0 20px;">' +
                    displayErrors.map(e => '<li>' + e + '</li>').join('') +
                    (result.errors.length > 20 ? '<li>...and ' + (result.errors.length - 20) + ' more</li>' : '') +
                    '</ul>';
            } else {
                errorList.innerHTML = '';
            }
        }
    </script>
</apex:page>