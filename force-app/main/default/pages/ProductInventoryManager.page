        function openComp1EditModal(id) {
            document.getElementById('comp1RecordId').value = id;

            // Show loading state
            showLoadingOverlay();

            // Fetch data via remote action
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.getCompetitorData}',
                id,
                1,
                function(result, event) {
                    hideLoadingOverlay();

                    if (event.status && result.success) {
                        // Populate fields with fetched data
                        const nameField = document.getElementById('comp1Name_edit');
                        const urlField = document.getElementById('comp1URL_edit');

                        nameField.value = result.name || '';
                        nameField.setAttribute('data-original-value', result.name || '');
                        document.getElementById('comp1Price_edit').value = result.price || '';
                        document.getElementById('comp1NewPrice_edit').value = result.newPrice || '';
                        urlField.value = result.url || '';
                        urlField.setAttribute('data-original-value', result.url || '');
                        document.getElementById('comp1GoogleDrive_edit').value = result.googleDrive || '';
                        document.getElementById('comp1URLNotes_edit').value = result.urlNotes || '';

                        // Update URL buttons
                        const urlBtn = document.getElementById('comp1URLBtn_edit');
                        const googleDriveBtn = document.getElementById('comp1GoogleDriveBtn_edit');

                        if (result.url) {
                            urlBtn.href = result.url;
                            urlBtn.style.opacity = '1';
                            urlBtn.style.pointerEvents = 'auto';
                        } else {
                            urlBtn.href = '#';
                            urlBtn.style.opacity = '0.4';
                            urlBtn.style.pointerEvents = 'none';
                        }

                        if (result.googleDrive) {
                            googleDriveBtn.href = result.googleDrive;
                            googleDriveBtn.style.opacity = '1';
                            googleDriveBtn.style.pointerEvents = 'auto';
                        } else {
                            googleDriveBtn.href = '#';
                            googleDriveBtn.style.opacity = '0.4';
                            googleDriveBtn.style.pointerEvents = 'none';
                        }

                        // Format and display last updated
                        const lastUpdatedDiv = document.getElementById('comp1LastUpdated_edit');
                        if (result.lastUpdated) {
                            lastUpdatedDiv.textContent = formatDateTime(result.lastUpdated);
                        } else {
                            lastUpdatedDiv.textContent = 'Not updated yet';
                        }

                        // Add input listeners to update URL buttons when fields change
                        const urlInput = document.getElementById('comp1URL_edit');
                        const googleDriveInput = document.getElementById('comp1GoogleDrive_edit');

                        // Remove old listeners by cloning
                        const newUrlInput = urlInput.cloneNode(true);
                        const newGoogleDriveInput = googleDriveInput.cloneNode(true);
                        urlInput.parentNode.replaceChild(newUrlInput, urlInput);
                        googleDriveInput.parentNode.replaceChild(newGoogleDriveInput, googleDriveInput);

                        newUrlInput.addEventListener('input', function() {
                            urlBtn.href = this.value || '#';
                            urlBtn.style.opacity = this.value ? '1' : '0.4';
                            urlBtn.style.pointerEvents = this.value ? 'auto' : 'none';
                        });
                        newGoogleDriveInput.addEventListener('input', function() {
                            googleDriveBtn.href = this.value || '#';
                            googleDriveBtn.style.opacity = this.value ? '1' : '0.4';
                            googleDriveBtn.style.pointerEvents = this.value ? 'auto' : 'none';
                        });

                        // Open modal
                        document.getElementById('comp1Overlay').classList.add('active');
                        document.getElementById('comp1EditModal').classList.add('active');
                    } else {
                        showNotification('error', 'Failed to load competitor data: ' + (result.error || 'Unknown error'));
                    }
                },
                {escape: true}
            );
        }

