        <apex:form id="mainForm">
            <!-- Action function for filter changes with proper ViewState synchronization -->
            <apex:actionFunction name="applyFiltersAction"
                                 action="{!search}"
                                 reRender="tableContainer,paginationContainer,searchPanelContent"
                                 status="loadingStatus"
                                 oncomplete="initTableAccessibility(); updateFilterStatus(); loadStats();" />

            <!-- Bulk action functions -->
            <apex:actionFunction name="executeBulkUpdateWebsite"
                                 action="{!bulkUpdateWebsite}"
                                 oncomplete="handleBulkActionComplete();" />

            <apex:actionFunction name="executeBulkOutOfStock"
                                 action="{!bulkOutOfStock}"
                                 oncomplete="handleBulkActionComplete();" />

            <apex:actionFunction name="executeBulkCopySupplierToInvoiceCost"
                                 action="{!bulkCopySupplierToInvoiceCost}"
                                 oncomplete="handleBulkActionComplete(); closeCopySupplierModal();" />

            <!-- Hidden input for supplier selection -->
            <apex:inputHidden value="{!supplierForInvoiceCost}" id="supplierForInvoiceCostInput" />

            <!-- Action function for refreshing table after updates - preserves filter state -->
            <!-- Note: Do NOT reRender searchPanelContent or filterPanelContent to preserve user's unsaved filter/search changes -->
            <apex:actionFunction name="refreshTableAction"
                                 action="{!search}"
                                 reRender="tableContainer,paginationContainer"
                                 status="loadingStatus"
                                 oncomplete="initTableAccessibility(); updateFilterStatus(); loadStats(); hideLoadingOverlay();" />

            <!-- Action function for changing page size - ensures proper ViewState sync -->
            <apex:actionFunction name="changePageSizeAction"
                                 action="{!changePageSize}"
                                 reRender="tableContainer,paginationContainer"
                                 status="loadingStatus"
                                 oncomplete="initTableAccessibility(); updateFilterStatus();" />

            <!-- Filter Panel (Collapsible) -->
