            }

            /* Focus state for inputs */
            #newProductModal .dataCol input:focus,
            #newProductModal .dataCol select:focus,
            #newProductModal .dataCol textarea:focus {
                outline: none !important;
                border-color: #3b82f6 !important;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
            }

            /* Hover state for inputs */
            #newProductModal .dataCol input:hover:not(:focus),
            #newProductModal .dataCol select:hover:not(:focus),
            #newProductModal .dataCol textarea:hover:not(:focus) {
                border-color: #94a3b8 !important;
            }

            /* Style checkboxes */
            #newProductModal .dataCol input[type="checkbox"] {
                width: 20px !important;
                height: 20px !important;
                cursor: pointer !important;
                accent-color: #3b82f6 !important;
            }

            /* Required field indicator */
            #newProductModal .requiredInput .requiredBlock {
                background-color: #94a3b8 !important;
                width: 4px !important;
                height: 4px !important;
                border-radius: 50% !important;
                display: inline-block !important;
                margin-left: 4px !important;
                margin-right: 0 !important;
                position: relative !important;
                top: -6px !important;
            }

            #newProductModal .requiredInput label {
                font-weight: 600 !important;
            }

            /* Error styling */
            #newProductModal .dataCol .error,
            #newProductModal .dataCol input.error,
            #newProductModal .dataCol select.error {
                border-color: #cbd5e1 !important;
                background-color: #f1f5f9 !important;
            }

            /* Help text styling */
            #newProductModal .helpText {
                font-size: 12px !important;
                color: #6b7280 !important;
                margin-top: 4px !important;
                font-style: italic !important;
            }

            /* Style apex:pageMessages */
            #newProductModal .messageTable {
                width: 100% !important;
                margin-bottom: 16px !important;
                border-radius: 8px !important;
                overflow: hidden !important;
            }

            #newProductModal .messageText {
                padding: 12px 16px !important;
                font-size: 14px !important;
            }

            #newProductModal .confirmM3 {
                background-color: #dcfce7 !important;
                border-left: 4px solid #10b981 !important;
                color: #065f46 !important;
            }

            #newProductModal .errorM3 {
                background-color: #f1f5f9 !important;
                border-left: 4px solid #cbd5e1 !important;
                color: #475569 !important;
            }

            #newProductModal .warningM3 {
                background-color: #f1f5f9 !important;
                border-left: 4px solid #cbd5e1 !important;
                color: #475569 !important;
            }

            #newProductModal .infoM3 {
                background-color: #dbeafe !important;
                border-left: 4px solid #3b82f6 !important;
                color: #1e40af !important;
            }

            /* Responsive adjustments for modal fields */
            @media (max-width: 768px) {
                #newProductModal .pbSubsection table {
                    grid-template-columns: 1fr !important;
                }
            }
            /* Tab Navigation */
            .tab-navigation {
                background: white;
                border-bottom: 1px solid #e5e7eb;
                box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            }

            .tab-container {
                max-width: 1600px;
                margin: 0 auto;
                padding: 0 24px;
                display: flex;
                gap: 8px;
            }

            .tab-link {
                padding: 16px 24px;
                font-size: 14px;
                font-weight: 500;
                color: #64748b;
                text-decoration: none;
                border-bottom: 3px solid transparent;
                transition: all 0.2s ease;
                position: relative;
            }

            .tab-link:hover {
                color: #0f172a;
                background: #f8fafc;
            }

            .tab-link.active {
                color: #3b82f6;
                border-bottom-color: #3b82f6;
                font-weight: 600;
            }

            .tab-link.active::after {
                content: '';
                position: absolute;
                bottom: -1px;
                left: 0;
                right: 0;
                height: 3px;
                background: #3b82f6;
            }

            .tab-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 20px;
                height: 20px;
                padding: 0 6px;
                margin-left: 8px;
                background: #e2e8f0;
                color: #475569;
                border-radius: 10px;
                font-size: 11px;
                font-weight: 600;
            }

            .tab-link.active .tab-badge {
                background: #dbeafe;
                color: #1e40af;
            }

            /* Stale Data Notification Banner */
            .stale-data-banner {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                background: linear-gradient(135deg, #0070d2 0%, #1e40af 100%);
                color: white;
                padding: 14px 20px;
                text-align: center;
                z-index: 10000;
                display: none;
                box-shadow: 0 4px 12px rgba(0, 112, 210, 0.3);
                animation: slideDown 0.3s ease-out;
            }

            @keyframes slideDown {
                from { transform: translateY(-100%); opacity: 0; }
                to { transform: translateY(0); opacity: 1; }
            }

            .stale-data-banner .banner-content {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 16px;
                flex-wrap: wrap;
            }

            .stale-data-banner .banner-icon {
                font-size: 20px;
            }

            .stale-data-banner .banner-message {
                font-size: 14px;
                font-weight: 500;
            }

            .stale-data-banner .banner-actions {
                display: flex;
                gap: 8px;
            }

            .stale-data-banner .btn-refresh {
                background: white;
                color: #0070d2;
                border: none;
                padding: 8px 20px;
                border-radius: 6px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

            .stale-data-banner .btn-refresh:hover {
                background: #f0f7ff;
                transform: translateY(-1px);
            }

            .stale-data-banner .btn-dismiss {
                background: transparent;
                color: white;
                border: 1px solid rgba(255,255,255,0.4);
                padding: 8px 16px;
                border-radius: 6px;
                cursor: pointer;
                font-size: 13px;
                transition: all 0.2s;
            }

            .stale-data-banner .btn-dismiss:hover {
                background: rgba(255,255,255,0.1);
                border-color: rgba(255,255,255,0.6);
            }

            .last-updated-indicator {
                font-size: 11px;
                color: #6b7280;
                margin-left: 12px;
            }

        </style>
    </head>

