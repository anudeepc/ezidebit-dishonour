        // Export data function
        function exportData() {
            // Show loading notification
            showNotification('success', 'Generating export... Please wait.');

            // Get current filter values from the form
            var searchTerm = document.querySelector('input[id*="searchInput"]') ? document.querySelector('input[id*="searchInput"]').value : '';
            var filterWebsite = document.querySelector('input[id*="chkWebsite"]') ? document.querySelector('input[id*="chkWebsite"]').checked : false;
            var filterErrors = document.querySelector('input[id*="chkErrors"]') ? document.querySelector('input[id*="chkErrors"]').checked : false;
            var filterURLs = document.querySelector('input[id*="chkURLs"]') ? document.querySelector('input[id*="chkURLs"]').checked : false;
            var filterPrice = document.querySelector('input[id*="chkPrice"]') ? document.querySelector('input[id*="chkPrice"]').checked : false;

            // Call remote action
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.exportProducts}',
                searchTerm,
                filterWebsite,
                filterErrors,
                filterURLs,
                filterPrice,
                function(result, event) {
                    if (event.status) {
                        if (result.startsWith('Error:')) {
                            showNotification('error', result);
                        } else {
                            // Create download link
                            var blob = new Blob([result], { type: 'text/csv;charset=utf-8;' });
                            var link = document.createElement('a');
                            var url = URL.createObjectURL(blob);
                            link.setAttribute('href', url);

                            // Generate filename with timestamp
                            var timestamp = new Date().toISOString().slice(0, 19).replace(/:/g, '-');
                            link.setAttribute('download', 'product_inventory_' + timestamp + '.csv');

                            link.style.visibility = 'hidden';
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);

                            showNotification('success', 'Export completed successfully!');
                        }
                    } else {
                        showNotification('error', 'Export failed: ' + event.message);
                    }
                },
                {escape: true}
            );
        }

        // Sticky header shadow on scroll
        function initStickyHeaderShadow() {
            const tableContainer = document.querySelector('.table-container');
            if (!tableContainer) return;

            tableContainer.addEventListener('scroll', function() {
                const tableHeaders = document.querySelectorAll('.inventory-table th');

                if (this.scrollTop > 10) {
                    tableHeaders.forEach(th => {
                        th.style.boxShadow = '0 2px 4px -1px rgba(0, 0, 0, 0.1), 0 4px 6px -1px rgba(0, 0, 0, 0.06)';
                    });
                } else {
                    tableHeaders.forEach(th => {
                        th.style.boxShadow = '0 2px 4px -1px rgba(0, 0, 0, 0)';
                    });
                }
            });
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            initStickyHeaderShadow();

            // Initialize sticky bulk actions bar with scroll effect
            const bulkActionsBar = document.getElementById('bulkActionsBar');
            if (bulkActionsBar) {
                let lastScrollTop = 0;
                window.addEventListener('scroll', function() {
                    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                    // Add 'scrolled' class when scrolling down past 50px
                    if (scrollTop > 50) {
                        bulkActionsBar.classList.add('scrolled');
                    } else {
                        bulkActionsBar.classList.remove('scrolled');
                    }

                    lastScrollTop = scrollTop;
                }, false);
            }

            // Enable Enter key for search input
            const searchInput = document.querySelector('input[id*="searchInput"]');
            const searchButton = document.querySelector('input[id*="searchButton"]');
            if (searchInput && searchButton) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        searchButton.click();
                    }
                });
