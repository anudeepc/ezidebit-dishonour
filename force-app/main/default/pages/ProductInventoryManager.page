    <script>
        let currentRecordData = null;
        let originalData = null;
        let hasUnsavedChanges = false;

        // Blocked competitor names - these retailers cannot be entered as competitors
        const BLOCKED_COMPETITORS = ['big w', 'bigw', 'office works', 'officeworks', 'target'];

        /**
         * Validates competitor name against blocked list
         * @param {string} name - The competitor name to validate
         * @returns {object} - { valid: boolean, message: string }
         */
        function validateCompetitorName(name) {
            if (!name || name.trim() === '') {
                return { valid: true, message: '' };
            }

            const normalizedName = name.toLowerCase().trim();

            // Check against blocked list
            for (const blocked of BLOCKED_COMPETITORS) {
                if (normalizedName === blocked || normalizedName.includes(blocked)) {
                    const displayName = blocked.charAt(0).toUpperCase() + blocked.slice(1);
                    return {
                        valid: false,
                        message: `"${name}" is not allowed as a competitor. Big W, Office Works, and Target cannot be entered as competitors.`
                    };
                }
            }

            return { valid: true, message: '' };
        }

        // Bulk action selection management
        let selectedProductIds = new Set();

        function toggleSelectAll(checkbox) {
            const productCheckboxes = document.querySelectorAll('.product-checkbox');
            productCheckboxes.forEach(cb => {
                cb.checked = checkbox.checked;
                const row = cb.closest('tr');
                if (checkbox.checked) {
                    selectedProductIds.add(cb.value);
                    row.classList.add('selected');
                } else {
                    selectedProductIds.delete(cb.value);
                    row.classList.remove('selected');
                }
            });
            updateSelection();
        }

        function updateSelection() {
            // Rebuild selection set from checkboxes
            selectedProductIds.clear();
            const productCheckboxes = document.querySelectorAll('.product-checkbox:checked');
            productCheckboxes.forEach(cb => {
                selectedProductIds.add(cb.value);
                const row = cb.closest('tr');
                row.classList.add('selected');
            });

            // Remove selected class from unchecked rows
            document.querySelectorAll('.product-checkbox:not(:checked)').forEach(cb => {
                cb.closest('tr').classList.remove('selected');
            });

            // Update select all checkbox
            const selectAllCheckbox = document.getElementById('selectAll');
            const allCheckboxes = document.querySelectorAll('.product-checkbox');
            const checkedCheckboxes = document.querySelectorAll('.product-checkbox:checked');
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = allCheckboxes.length > 0 && allCheckboxes.length === checkedCheckboxes.length;
            }

            // Update UI
            const count = selectedProductIds.size;
            document.getElementById('selectionCount').textContent = count;
            document.getElementById('bulkActionsBar').style.display = count > 0 ? 'flex' : 'none';

            // Offer only the availability action that applies to the current selection. A mixed
            // selection shows both, with counts, so it is clear each button acts on its own subset
            // rather than on everything ticked.
            let onSaleSelected = 0, outOfStockSelected = 0;
            document.querySelectorAll('.product-checkbox:checked').forEach(cb => {
                if (cb.getAttribute('data-disabled') === 'true') {
                    outOfStockSelected++;
                } else {
                    onSaleSelected++;
                }
            });

            const bulkOutOfStockBtn = document.getElementById('bulkOutOfStockBtn');
            if (bulkOutOfStockBtn) {
                bulkOutOfStockBtn.style.display = onSaleSelected > 0 ? 'block' : 'none';
                bulkOutOfStockBtn.textContent = outOfStockSelected > 0
                    ? 'Out of Stock (' + onSaleSelected + ')'
                    : 'Out of Stock';
                bulkOutOfStockBtn.title = 'Take ' + onSaleSelected + ' selected product'
                    + (onSaleSelected === 1 ? '' : 's') + ' off sale on the website';
            }

            const bulkReactivateBtn = document.getElementById('bulkReactivateBtn');
            if (bulkReactivateBtn) {
                bulkReactivateBtn.style.display = outOfStockSelected > 0 ? 'block' : 'none';
                bulkReactivateBtn.textContent = onSaleSelected > 0
                    ? 'Put Back On Sale (' + outOfStockSelected + ')'
                    : 'Put Back On Sale';
                bulkReactivateBtn.title = 'Put ' + outOfStockSelected + ' selected product'
                    + (outOfStockSelected === 1 ? '' : 's') + ' back on sale at current pricing';
            }

            // The secondary bulk toolbar carries the same pair of actions.
            const altOutOfStockBtn = document.getElementById('btnBulkOutOfStock');
            if (altOutOfStockBtn) {
                altOutOfStockBtn.style.display = onSaleSelected > 0 ? 'inline-flex' : 'none';
            }
            const altReactivateBtn = document.getElementById('btnBulkReactivate');
            if (altReactivateBtn) {
                altReactivateBtn.style.display = outOfStockSelected > 0 ? 'inline-flex' : 'none';
            }

            // Update hidden input with selected IDs
            const selectedIdsInput = document.querySelector('[id$="selectedIdsInput"]');
            if (selectedIdsInput) {
                selectedIdsInput.value = Array.from(selectedProductIds).join(',');
            }
        }

