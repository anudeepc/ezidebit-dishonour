        // Track selected variance ranges for multi-select
        var selectedVarianceRanges = new Set();

        // Map tile types to their variance range values
        var varianceTileMap = {
            'varianceUnder5': 'under5',
            'variance5to15': '5to15',
            'variance15to25': '15to25',
            'varianceOver25': 'over25',
            'noVariance': 'noVariance'
        };

        /**
         * Filter by clicking stat tiles
         * Variance tiles support multi-select (toggle behavior)
         * Checkbox tiles (website, errors, urls, price) toggle independently
         * All filters can be combined (AND logic between filter types)
         */
        function filterByTile(tileType) {
            // Get filter checkboxes
            var chkWebsite = document.querySelector('input[id*="chkWebsite"]');
            var chkErrors = document.querySelector('input[id*="chkErrors"]');
            var chkURLs = document.querySelector('input[id*="chkURLs"]');
            var chkPrice = document.querySelector('input[id*="chkPrice"]');
            var chkDisabled = document.querySelector('input[id*="chkDisabled"]');
            var varianceSelect = document.querySelector('select[id*="varianceSelect"]');

            // Check if this is a variance tile (supports multi-select)
            if (varianceTileMap[tileType]) {
                var rangeValue = varianceTileMap[tileType];
                var tileCard = document.getElementById('tile_' + tileType);

                // Toggle the selection
                if (selectedVarianceRanges.has(rangeValue)) {
                    selectedVarianceRanges.delete(rangeValue);
                    if (tileCard) tileCard.classList.remove('selected');
                } else {
                    selectedVarianceRanges.add(rangeValue);
                    if (tileCard) tileCard.classList.add('selected');
                }

                // Update the select field with comma-separated values
                // NOTE: Do NOT clear checkbox filters - allow combining
                if (varianceSelect) {
                    if (selectedVarianceRanges.size === 0) {
                        varianceSelect.value = 'All';
                    } else {
                        varianceSelect.value = Array.from(selectedVarianceRanges).join(',');
                    }
                }
            } else if (tileType === 'all') {
                // "All" tile: clear everything
                clearVarianceSelections();
                clearCheckboxTileSelections();
                if (chkWebsite) chkWebsite.checked = false;
                if (chkErrors) chkErrors.checked = false;
                if (chkURLs) chkURLs.checked = false;
                if (chkPrice) chkPrice.checked = false;
                if (chkDisabled) chkDisabled.checked = false;
            var chkDriftClear = document.querySelector('input[id*="chkWebsiteDrift"]');
            if (chkDriftClear) chkDriftClear.checked = false;
                var chkDriftAll = document.querySelector('input[id*="chkWebsiteDrift"]');
                if (chkDriftAll) chkDriftAll.checked = false;
                var chkMarginAll = document.querySelector('input[id*="chkMarginBelow"]');
                if (chkMarginAll) chkMarginAll.checked = false;
                if (varianceSelect) varianceSelect.value = 'All';
            } else {
                // Checkbox tiles: toggle the specific checkbox and visual state
                // NOTE: Do NOT clear variance selections - allow combining
                var tileCard = document.getElementById('tile_' + tileType);
                if (tileType === 'website') {
                    if (chkWebsite) {
                        chkWebsite.checked = !chkWebsite.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkWebsite.checked);
                    }
                } else if (tileType === 'errors') {
                    if (chkErrors) {
                        chkErrors.checked = !chkErrors.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkErrors.checked);
                    }
                } else if (tileType === 'urls') {
                    if (chkURLs) {
                        chkURLs.checked = !chkURLs.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkURLs.checked);
                    }
                } else if (tileType === 'priceChange') {
                    if (chkPrice) {
                        chkPrice.checked = !chkPrice.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkPrice.checked);
                    }
                } else if (tileType === 'outOfStock') {
                    if (chkDisabled) {
                        chkDisabled.checked = !chkDisabled.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkDisabled.checked);
                    }
                } else if (tileType === 'websiteDrift') {
                    var chkDrift = document.querySelector('input[id*="chkWebsiteDrift"]');
                    if (chkDrift) {
                        chkDrift.checked = !chkDrift.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkDrift.checked);
                    }
                } else if (tileType === 'marginBelow') {
                    var chkMargin = document.querySelector('input[id*="chkMarginBelow"]');
                    if (chkMargin) {
                        chkMargin.checked = !chkMargin.checked;
                        if (tileCard) tileCard.classList.toggle('selected', chkMargin.checked);
                    }
                }
            }

            // Apply filters
            applyFilters();
        }

