        // Show loading overlay with countdown and auto-refresh
        function showSyncLoadingAndRefresh(seconds) {
            const overlay = document.getElementById('savingOverlay');
            const textElement = document.getElementById('savingText');

            if (!overlay || !textElement) return;

            let countdown = seconds;

            // Update text and show overlay
            textElement.textContent = 'Syncing to WooCommerce... Page will refresh in ' + countdown + ' seconds';
            overlay.classList.add('show');

            // Countdown timer
            const countdownInterval = setInterval(function() {
                countdown--;
                if (countdown > 0) {
                    textElement.textContent = 'Syncing to WooCommerce... Page will refresh in ' + countdown + ' seconds';
                } else {
                    clearInterval(countdownInterval);
                    textElement.textContent = 'Refreshing...';
                    // Refresh table preserving filters
                    refreshTablePreservingFilters();
                }
            }, 1000);
        }

        function showLoading() {
            showLoadingOverlay();
        }

        function hideLoading() {
            hideLoadingOverlay();
        }

        // AJAX refresh that preserves filter state (replaces location.reload())
        function refreshTablePreservingFilters() {
            showLoadingOverlay();
            // Call the Visualforce actionFunction to refresh table with current filters
            if (typeof refreshTableAction === 'function') {
                refreshTableAction();
            } else {
                // Fallback to applyFiltersAction if refreshTableAction is not available
                applyFiltersAction();
            }
        }

        // ============================================
        // BACKGROUND UPDATE POLLING SYSTEM
        // Checks for background updates and notifies user
        // without auto-refreshing or disrupting work
        // ============================================

        const POLL_INTERVAL = 45000; // Check every 45 seconds
        let lastCheckTimestamp = new Date();
        let pollingEnabled = true;
        let pollingTimer = null;
        let bannerDismissed = false;
        let isUserEditing = false;

        // Start polling when page loads
        document.addEventListener('DOMContentLoaded', function() {
            startBackgroundPolling();
        });

        /**
         * Start the background polling mechanism
         */
        function startBackgroundPolling() {
            if (pollingTimer) {
                clearInterval(pollingTimer);
            }

            pollingTimer = setInterval(function() {
                if (pollingEnabled && !bannerDismissed && !isUserEditing) {
                    checkForBackgroundUpdates();
                }
            }, POLL_INTERVAL);

            console.log('Background polling started: checking every ' + (POLL_INTERVAL/1000) + ' seconds');
        }

        /**
         * Check if records have been updated since last check
         */
        function checkForBackgroundUpdates() {
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.checkForUpdates}',
                lastCheckTimestamp.toISOString(),
                function(result, event) {
                    if (event.status && result.success && result.hasUpdates) {
                        showStaleBanner(result.updateCount);
                    }
                    // Update timestamp for next check
                    lastCheckTimestamp = new Date();
                },
                {escape: true, timeout: 10000}
            );
        }

        /**
         * Show the stale data notification banner
         */
        function showStaleBanner(updateCount) {
            const banner = document.getElementById('staleDataBanner');
            const message = document.getElementById('staleDataMessage');

            if (updateCount > 0) {
                message.textContent = updateCount + ' record' + (updateCount > 1 ? 's have' : ' has') + ' been updated in the background. Refresh to see latest data.';
            } else {
                message.textContent = 'New updates are available for this inventory.';
            }

            banner.style.display = 'block';
        }

        /**
         * Show banner after save - record stays in place, user can refresh to update list order
         */
        function showSaveSuccessBanner() {
            const banner = document.getElementById('staleDataBanner');
            const message = document.getElementById('staleDataMessage');

            message.textContent = 'Record saved successfully. Click "Refresh Now" to update list order.';
            banner.style.display = 'block';
        }

        /**
         * Format price as currency
         */
        function formatPrice(price) {
            if (price === null || price === undefined || price === '') return null;
            const num = parseFloat(price);
            if (isNaN(num)) return null;
            return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        /**
         * Update competitor cell in the DOM after save
         */
        function updateCompetitorCell(recordId, compNum, name, price, url, newPrice) {
            const row = document.querySelector('tr[data-record-id="' + recordId + '"]');
            if (!row) return;

            const cell = row.querySelector('td[data-field="comp' + compNum + '"]');
            if (!cell) return;

            const cellContent = cell.querySelector('.cell-content');
            if (!cellContent) return;

            let html = '';
            if (name) {
                html = '<span class="competitor-name">' + escapeHtml(name) + '</span>';
                html += '<span class="competitor-price">';
                if (price) {
                    html += formatPrice(price);
                } else {
                    html += '<span class="data-empty">No price</span>';
                }
                html += '</span>';
                if (newPrice) {
                    html += '<span class="new-price" title="Latest extracted price">New: ' + formatPrice(newPrice) + '</span>';
                }
                html += '<span class="last-updated" title="Just updated">Just now</span>';
                if (url) {
                    html += '<a href="' + escapeHtml(url) + '" target="_blank" rel="noopener noreferrer" class="url-link" onclick="event.stopPropagation()">View Source</a>';
                }
            } else {
                html = '<span class="data-missing">Not Set</span>';
            }

            cellContent.innerHTML = html;
        }

