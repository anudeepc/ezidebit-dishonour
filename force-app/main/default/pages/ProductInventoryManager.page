        // Make table rows keyboard accessible
        function initTableAccessibility() {
            // Make table rows keyboard accessible
            document.querySelectorAll('.inventory-table tbody tr').forEach(row => {
                row.setAttribute('tabindex', '0');
                row.setAttribute('role', 'button');
                row.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });

            // Update sort indicators based on current sort state
            updateSortIndicators();

            // Update filtered count display
            updateFilteredCountDisplay();
        }

        /**
         * Update pagination display to show actual filtered record count
         * This handles the case where client-side variance filters reduce displayed records
         */
        function updateFilteredCountDisplay() {
            // Count actual visible rows in the table
            var tableRows = document.querySelectorAll('.inventory-table tbody tr');
            var actualRowCount = tableRows.length;

            // Get all pagination elements
            var filteredCountTop = document.getElementById('filteredCountTop');
            var filteredCountBottom = document.getElementById('filteredCountBottom');
            var paginationRangeTop = document.getElementById('paginationRangeTop');
            var paginationRangeBottom = document.getElementById('paginationRangeBottom');
            var paginationTotalTop = document.getElementById('paginationTotalTop');
            var paginationTotalBottom = document.getElementById('paginationTotalBottom');

            // Check if variance filter is active
            var hasVarianceFilter = selectedVarianceRanges && selectedVarianceRanges.size > 0;

            if (hasVarianceFilter) {
                // Server handles filtering and pagination correctly - just add the indicator
                // The actualRowCount shows records returned by server after filtering
                if (actualRowCount > 0) {
                    // Show filtered indicator - server values are already correct
                    if (filteredCountTop) filteredCountTop.textContent = ' (variance filtered)';
                    if (filteredCountBottom) filteredCountBottom.textContent = ' (variance filtered)';
                } else {
                    // No records match the filter
                    if (filteredCountTop) filteredCountTop.textContent = ' (no matches)';
                    if (filteredCountBottom) filteredCountBottom.textContent = ' (no matches)';
                }
            } else {
                // Clear filtered indicator when no variance filter
                if (filteredCountTop) filteredCountTop.textContent = '';
                if (filteredCountBottom) filteredCountBottom.textContent = '';
            }
        }

        function updateSortIndicators() {
            // Get current sort state from controller
            var currentSortField = '{!JSENCODE(sortField)}';
            var currentSortOrder = '{!JSENCODE(sortOrder)}';

            // Remove all sort state classes
            document.querySelectorAll('.inventory-table th.sortable').forEach(function(th) {
                th.classList.remove('sort-asc', 'sort-desc');
            });

            // If we have a sort field, find and mark the sorted column
            if (currentSortField) {
                // Map of field names to their index (0-based)
                var fieldIndexMap = {
                    'Name': 0,
                    'StatusOrder': 1,
                    'Cash_Price__c': 2,
                    'Competitor_1_Market_Value__c': 3,
                    'Competitor_2_Market_Value__c': 4,
                    'Competitor_3_Market_Value__c': 5,
                    'Supplier_1_Price__c': 6,
                    'Supplier_2_Price__c': 7
                };

                var columnIndex = fieldIndexMap[currentSortField];
                if (columnIndex !== undefined) {
                    var sortedHeader = document.querySelectorAll('.inventory-table th.sortable')[columnIndex];
                    if (sortedHeader) {
                        var sortClass = currentSortOrder === 'DESC' ? 'sort-desc' : 'sort-asc';
                        sortedHeader.classList.add(sortClass);

                        // Update ARIA label for accessibility
                        var link = sortedHeader.querySelector('a');
                        if (link) {
                            var columnName = link.textContent.trim();
                            var sortDirection = currentSortOrder === 'DESC' ? 'descending' : 'ascending';
                            link.setAttribute('aria-label', 'Sort by ' + columnName + ', currently sorted ' + sortDirection);
                        }
                    }
                }
            }
        }

        /**
         * Convert UTC datetime to local timezone
         */
        function convertUTCToLocal() {
            document.querySelectorAll('.local-datetime').forEach(function(element) {
                const utcDateStr = element.getAttribute('data-utc');
                if (!utcDateStr) return;

                try {
                    // Parse the UTC datetime string
                    const utcDate = new Date(utcDateStr);

                    // Format to local timezone
                    const options = {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: 'numeric',
                        minute: '2-digit',
                        hour12: true
                    };

                    const localDateStr = utcDate.toLocaleString('en-AU', options);
                    element.textContent = localDateStr;
                } catch (e) {
                    console.error('Error converting datetime:', e);
                    element.textContent = utcDateStr; // Fallback to UTC string
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            initTableAccessibility();
            // Load stats on page load - use unfiltered to get true totals
            loadStats(true);
            // Convert UTC datetimes to local timezone
            convertUTCToLocal();

            // Update filter status on page load
            updateFilterStatus();
        });

        // Toggle collapsible panels
        function togglePanel(panelName) {
            const panels = ['stats', 'filter', 'search'];
            const panel = document.getElementById(panelName + 'Panel');
            const btn = document.getElementById(panelName + 'Toggle');

            // Close all other panels
            panels.forEach(p => {
                if (p !== panelName) {
                    const otherPanel = document.getElementById(p + 'Panel');
                    const otherBtn = document.getElementById(p + 'Toggle');
                    if (otherPanel) otherPanel.style.display = 'none';
                    if (otherBtn) otherBtn.classList.remove('active');
                }
            });

            // Toggle current panel
            if (panel) {
                const isHidden = panel.style.display === 'none';
                panel.style.display = isHidden ? 'block' : 'none';
                if (btn) {
                    if (isHidden) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                }
            }
        }

        // Scroll to top of table
        function scrollToTop() {
            const tableContainer = document.getElementById('tableContainer');
            if (tableContainer) {
                tableContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // Update filter status text
        function updateFilterStatus() {
            const statusEl = document.getElementById('filterStatus');
            const countEl = document.getElementById('displayCount');

            // Get pagination info from the pagination text
            const paginationText = document.querySelector('.pagination-info');
            let rangeText = '-';
            let totalRecords = '-';
            let startRecord = '-';
            let endRecord = '-';

            if (paginationText) {
                // Extract "Showing 1-50 of 250"
                const fullMatch = paginationText.textContent.match(/Showing\s+(\d+)-(\d+)\s+of\s+(\d+)/);
                if (fullMatch) {
                    startRecord = fullMatch[1];
                    endRecord = fullMatch[2];
                    totalRecords = fullMatch[3];
                    rangeText = startRecord + '-' + endRecord + ' of ' + totalRecords;
                } else {
                    // Fallback to just total
                    const match = paginationText.textContent.match(/of\s+(\d+)/);
                    if (match) {
                        totalRecords = match[1];
                        rangeText = totalRecords;
                    }
                }
            }

            if (countEl) {
                countEl.textContent = rangeText;
            }

            // Check which filters are active
            const filterWebsite = document.querySelector('input[id*="chkWebsite"]') ? document.querySelector('input[id*="chkWebsite"]').checked : false;
            const filterErrors = document.querySelector('input[id*="chkErrors"]') ? document.querySelector('input[id*="chkErrors"]').checked : false;
            const filterURLs = document.querySelector('input[id*="chkURLs"]') ? document.querySelector('input[id*="chkURLs"]').checked : false;
            const filterPrice = document.querySelector('input[id*="chkPrice"]') ? document.querySelector('input[id*="chkPrice"]').checked : false;
            const searchTerm = document.querySelector('input[id*="searchInput"]') ? document.querySelector('input[id*="searchInput"]').value : '';

            let statusText = '';
            let suffix = totalRecords !== '-' && parseInt(totalRecords) !== 1 ? 'products' : 'product';

            if (filterWebsite) {
                statusText = 'Showing <span id="displayCount">' + rangeText + '</span> website ' + suffix;
            } else if (filterErrors) {
                statusText = 'Showing <span id="displayCount">' + rangeText + '</span> ' + suffix + ' with errors';
            } else if (filterURLs) {
                statusText = 'Showing <span id="displayCount">' + rangeText + '</span> ' + suffix + ' with missing URLs';
            } else if (filterPrice) {
                statusText = 'Showing <span id="displayCount">' + rangeText + '</span> ' + suffix + ' with price discrepancies';
            } else if (searchTerm) {
                statusText = 'Showing <span id="displayCount">' + rangeText + '</span> search results';
            } else {
                statusText = 'Showing <span id="displayCount">' + rangeText + '</span> ' + suffix;
            }

            if (statusEl) {
                statusEl.innerHTML = statusText;
            }
        }

        // Load statistics
        // unfiltered: if true, ignores current filters and gets all stats (used on initial page load)
        function loadStats(unfiltered) {
            // Get current filter state to pass to getStats (unless unfiltered is true)
            var filterWebsite = false;
            var filterErrors = false;
            var filterURLs = false;
            var category = 'All';

            if (!unfiltered) {
                filterWebsite = document.querySelector('input[id*="chkWebsite"]') ? document.querySelector('input[id*="chkWebsite"]').checked : false;
                filterErrors = document.querySelector('input[id*="chkErrors"]') ? document.querySelector('input[id*="chkErrors"]').checked : false;
                filterURLs = document.querySelector('input[id*="chkURLs"]') ? document.querySelector('input[id*="chkURLs"]').checked : false;
                var categorySelect = document.querySelector('select[id*="categorySelect"]');
                category = categorySelect ? categorySelect.value : 'All';
            }

            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.ProductInventoryController.getStats}',
                filterWebsite,
                filterErrors,
                filterURLs,
                category,
                function(result, event) {
                    if (event.status && result.success) {
