            <apex:outputPanel id="filterPanelContent">
                <div class="filter-panel">
                    <div class="filter-sections">
                        <!-- Dropdowns Row -->
                        <div class="filter-dropdowns">
                            <div class="filter-dropdown">
                                <label>Category</label>
                                <apex:selectList value="{!selectedCategory}" id="categorySelect" size="1" onchange="applyFilters();">
                                    <apex:selectOptions value="{!categoryOptions}" />
                                </apex:selectList>
                            </div>
                            <div class="filter-dropdown">
                                <label>Variance</label>
                                <apex:selectList value="{!selectedVarianceRange}" id="varianceSelect" size="1" onchange="applyFilters();">
                                    <apex:selectOptions value="{!varianceRangeOptions}" />
                                </apex:selectList>
                            </div>
                            <div class="filter-dropdown">
                                <label>Supplier/Competitor</label>
                                <apex:selectList value="{!selectedSupplierCompetitor}" id="supplierCompetitorSelect" size="1" onchange="applyFilters();">
                                    <apex:selectOptions value="{!supplierCompetitorOptions}" />
                                </apex:selectList>
                            </div>
                            <div class="filter-dropdown">
                                <label>Brand</label>
                                <apex:selectList value="{!selectedBrand}" id="brandSelect" size="1" onchange="applyFilters();">
                                    <apex:selectOptions value="{!brandOptions}" />
                                </apex:selectList>
                            </div>
                        </div>

                        <!-- Toggle Filters Row -->
                        <div class="filter-options">
                            <div class="filter-checkbox" id="filterWebsite">
                                <apex:inputCheckbox value="{!filterWebsiteProducts}" id="chkWebsite" onclick="applyFilters();" />
                                <label for="{!$Component.chkWebsite}">Website Only</label>
                            </div>
                            <div class="filter-checkbox" id="filterErrors">
                                <apex:inputCheckbox value="{!filterProductsWithErrors}" id="chkErrors" onclick="applyFilters();" />
                                <label for="{!$Component.chkErrors}">With Errors</label>
                            </div>
                            <div class="filter-checkbox" id="filterURLs">
                                <apex:inputCheckbox value="{!filterMissingURLs}" id="chkURLs" onclick="applyFilters();" />
                                <label for="{!$Component.chkURLs}">Missing URLs</label>
                            </div>
                            <div class="filter-checkbox" id="filterPrice">
                                <apex:inputCheckbox value="{!filterPriceDiscrepancies}" id="chkPrice" onclick="applyFilters();" />
                                <label for="{!$Component.chkPrice}">Price Issues</label>
                            </div>
                            <div class="filter-checkbox" id="filterDraft">
                                <apex:inputCheckbox value="{!filterDraftProducts}" id="chkDraft" onclick="applyFilters();" />
                                <label for="{!$Component.chkDraft}">Draft</label>
                            </div>
                            <div class="filter-checkbox" id="filterDisabled">
                                <apex:inputCheckbox value="{!filterDisabledProducts}" id="chkDisabled" onclick="applyFilters();" />
                                <label for="{!$Component.chkDisabled}">Disabled</label>
                            </div>
                            <div class="filter-checkbox" id="filterWebsiteDrift">
                                <apex:inputCheckbox value="{!filterWebsiteDrift}" id="chkWebsiteDrift" onclick="applyFilters();" />
                                <label for="{!$Component.chkWebsiteDrift}">Website Disagrees</label>
                            </div>
                            <div class="filter-checkbox" id="filterMarginBelow">
                                <apex:inputCheckbox value="{!filterBelowTargetMargin}" id="chkMarginBelow" onclick="applyFilters();" />
                                <label for="{!$Component.chkMarginBelow}">Margin below 15%</label>
                            </div>
                        </div>

                        <!-- Actions Row -->
                        <div class="filter-actions">
                            <button type="button" class="btn btn-secondary" onclick="showAllProducts(); return false;">
                                Show All
                            </button>
                            <apex:commandButton value="Clear Filters"
                                                action="{!clearFilters}"
                                                reRender="filterPanelContent,tableContainer,paginationContainer"
                                                styleClass="btn btn-cancel"
                                                status="loadingStatus"
                                                oncomplete="initTableAccessibility(); updateFilterStatus(); loadStats(); showNotification('success', 'Filters cleared');" />
                        </div>
                    </div>
                </div>
            </apex:outputPanel>
            </div>

            <!-- Search Panel (Collapsible) -->
            <div class="collapsible-panel" id="searchPanel" style="display: none;">
            <apex:outputPanel id="searchPanelContent">
            <div class="search-bar">
                <apex:inputText value="{!searchTerm}"
                                id="searchInput"
                                styleClass="search-input"
                                html-placeholder="Search by ID, name, supplier, competitor, price..." />
                <apex:commandButton value="Search"
                                    id="searchButton"
                                    action="{!search}"
                                    reRender="tableContainer,paginationContainer,filterPanelContent,searchPanelContent"
                                    styleClass="btn btn-primary"
                                    status="loadingStatus"
                                    oncomplete="initTableAccessibility(); updateFilterStatus();" />
                <apex:outputPanel rendered="{!AND(NOT(ISBLANK(searchTerm)), filterWebsiteProducts)}" styleClass="search-hint">
                    <span style="color: #64748b; font-size: 13px; font-weight: 500;">⚠️ Searching only website products. Uncheck "Show Only Website Products" to search all.</span>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!selectedCategory != 'All'}" styleClass="search-hint">
                    <span style="color: #3b82f6; font-size: 13px; font-weight: 500;">📁 Filtering by category: <strong>{!selectedCategory}</strong></span>
                </apex:outputPanel>
            </div>
            </apex:outputPanel>
            </div>

            <!-- Bulk Actions Bar -->
            <apex:outputPanel id="bulkActionsPanel">
                <div class="bulk-actions-bar" id="bulkActionsBar" style="display: none;">
                    <div class="selection-info">
                        <span>Selected:</span>
                        <span class="selection-count" id="selectionCount">0</span>
                    </div>

                    <div class="bulk-action-divider"></div>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnBulkWebsiteAdd"
                            onclick="showBulkWebsiteDialog(true)"
                            title="Update selected products on website">
                        Update Website Price
                    </button>

                    <button type="button"
                            class="btn btn-warning"
                            id="btnBulkWebsiteRemove"
                            onclick="showBulkWebsiteDialog(false)"
                            title="Remove selected products from website">
                        Remove from Website
                    </button>

                    <div class="bulk-action-divider"></div>

                    <button type="button"
                            class="btn btn-danger"
                            id="btnBulkOutOfStock"
                            onclick="bulkOutOfStock()"
                            title="Take selected products off sale on the website">
                        Out of Stock
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            id="btnBulkReactivate"
                            onclick="bulkReactivateProducts()"
                            title="Put selected products back on sale at current pricing">
                        Put Back On Sale
                    </button>

                    <button type="button"
                            class="btn"
                            id="btnBulkTerms"
                            onclick="openTermsEditor(null)"
                            title="Choose which contract terms the website offers for the selected products">
                        Contract Terms
                    </button>

                    <div class="bulk-action-divider"></div>

                    <button type="button"
                            class="btn btn-success"
                            id="btnBulkCopySupplier"
                            onclick="showCopySupplierModal()"
                            title="Copy Supplier Price (excl GST) to Invoice Cost"
                            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        Copy Supplier to Invoice Cost
                    </button>

                    <button type="button"
                            class="btn btn-cancel"
                            onclick="clearSelection()"
                            title="Clear selection">
                        Clear Selection
                    </button>

                    <!-- Hidden input to store selected IDs -->
                    <apex:inputHidden value="{!selectedProductIds}" id="selectedIdsInput" />
                    <apex:inputHidden value="{!bulkWebsiteStatus}" id="websiteStatusInput" />
                </div>
            </apex:outputPanel>

            <!-- Pagination Controls Top -->
            <apex:outputPanel id="paginationContainer">
                <apex:outputPanel rendered="{!totalRecords > 0}" styleClass="pagination-container">
                    <div class="pagination-info" id="paginationInfoTop">
                        Showing <strong><span id="paginationRangeTop">{!(pageNumber-1)*pageSize + 1}-{!MIN(pageNumber*pageSize, totalRecords)}</span></strong> of <strong><span id="paginationTotalTop">{!totalRecords}</span></strong> products
                        <span id="filteredCountTop" style="color: #3b82f6; font-weight: 500;"></span>
                    </div>

                    <div class="pagination-controls">
                        <apex:commandButton value="First"
                                            action="{!firstPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasPrevious)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility();" />

                        <apex:commandButton value="Previous"
                                            action="{!previousPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasPrevious)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility();" />

                        <apex:repeat value="{!pageNumbers}" var="pageNum">
                            <apex:commandButton value="{!pageNum}"
                                                action="{!goToPage}"
                                                reRender="tableContainer,paginationContainer"
                                                styleClass="pagination-btn {!IF(pageNum == pageNumber, 'active', '')}"
                                                status="loadingStatus"
                                                oncomplete="initTableAccessibility();">
                                <apex:param name="selectedPage" value="{!pageNum}" assignTo="{!pageNumber}" />
                            </apex:commandButton>
                        </apex:repeat>

                        <apex:commandButton value="Next"
                                            action="{!nextPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasNext)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility();" />

                        <apex:commandButton value="Last"
                                            action="{!lastPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasNext)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility();" />
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <label for="pageSizeTop" style="font-size: 14px; color: #6b7280;">Show:</label>
                        <apex:selectList id="pageSizeTop" value="{!pageSize}" size="1" styleClass="page-size-select" onchange="handlePageSizeChange(this);">
                            <apex:selectOption itemValue="25" itemLabel="25" />
                            <apex:selectOption itemValue="50" itemLabel="50" />
                            <apex:selectOption itemValue="100" itemLabel="100" />
                            <apex:selectOption itemValue="250" itemLabel="250" />
                            <apex:selectOption itemValue="500" itemLabel="500" />
                            <apex:selectOption itemValue="1000" itemLabel="1000" />
                        </apex:selectList>
                    </div>
                </apex:outputPanel>
            </apex:outputPanel>

            <apex:outputPanel id="tableContainer">
                <div class="table-container">
                    <div class="table-wrapper">
                        <!-- Loading Status Indicator -->
                        <apex:actionStatus id="loadingStatus">
                            <apex:facet name="start">
                                <div class="loading-overlay">
                                    <div class="loading-content">
                                        <div class="loading-spinner"></div>
                                        <div class="loading-text">Loading products...</div>
                                    </div>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>

                        <apex:outputPanel rendered="{!inventoryRecords.size > 0}">
                            <table class="inventory-table">
                                <thead>
                                    <tr>
                                        <th class="checkbox-cell">
                                            <input type="checkbox" id="selectAll" onclick="toggleSelectAll(this)" title="Select All" />
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Name" assignTo="{!sortField}" />
                                                Product
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="StatusOrder" assignTo="{!sortField}" />
                                                Status
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Cash_Price__c" assignTo="{!sortField}" />
                                                Cash Price
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Competitor_1_Market_Value__c" assignTo="{!sortField}" />
                                                Competitor 1
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Competitor_2_Market_Value__c" assignTo="{!sortField}" />
                                                Competitor 2
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Competitor_3_Market_Value__c" assignTo="{!sortField}" />
                                                Competitor 3
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Supplier_1_Price__c" assignTo="{!sortField}" />
                                                Supplier 1
                                            </apex:commandLink>
                                        </th>
                                        <th class="sortable">
                                            <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                                <apex:param name="sortFieldParam" value="Supplier_2_Price__c" assignTo="{!sortField}" />
                                                Supplier 2
                                        </apex:commandLink>
                                    </th>
                                    <th class="sortable">
                                        <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                            <apex:param name="sortFieldParam" value="Delivery_Partner__c" assignTo="{!sortField}" />
                                            Delivery
                                        </apex:commandLink>
                                    </th>
                                    <th class="sortable">
                                        <apex:commandLink action="{!sortBy}" reRender="tableContainer,paginationContainer" status="loadingStatus" oncomplete="initTableAccessibility();">
                                            <apex:param name="sortFieldParam" value="Website_Update_Date__c" assignTo="{!sortField}" />
                                            Website
                                        </apex:commandLink>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <apex:repeat value="{!inventoryRecords}" var="item">
                                    <tr onclick="handleRowClick(event, '{!item.record.Id}')"
                                        data-record-id="{!item.record.Id}"
                                        class="{!IF(item.hasSupplierError, 'row-has-error', IF(item.hasPriceDiscrepancy, 'row-price-discrepancy', IF(item.record.In_R4K_Website__c, 'row-website-product', '')))}">
                                        <td class="checkbox-cell" onclick="event.stopPropagation()">
                                            <!-- data-disabled lets the bulk toolbar offer only the action that
                                                 applies to what is actually selected. -->
                                            <input type="checkbox" class="product-checkbox" value="{!item.record.Id}" data-disabled="{!IF(item.record.Manual_Disable__c, 'true', 'false')}" onchange="updateSelection()" />
                                        </td>
                                        <td>
                                            <div class="cell-content">
                                                <span class="product-name">
                                                    <apex:outputText value="{!item.record.ProductName__c}" rendered="{!item.record.ProductName__c != null}" />
                                                    <apex:outputText value="{!item.record.Name}" rendered="{!item.record.ProductName__c == null}" />
                                                </span>
                                                <span class="product-code">{!item.record.Name}</span>
                                                <div class="indicator-icons">
                                                    <apex:outputPanel rendered="{!item.record.In_R4K_Website__c}">
                                                        <span class="indicator-icon icon-website" title="On Website">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                                        </span>
                                                    </apex:outputPanel>
                                                    <apex:outputPanel rendered="{!item.hasSupplierError}">
                                                        <span class="indicator-icon icon-error" title="Has Error">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                        </span>
                                                    </apex:outputPanel>
                                                    <apex:outputPanel rendered="{!item.hasMissingURL}">
                                                        <span class="indicator-icon icon-url" title="Missing URL">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                                        </span>
                                                    </apex:outputPanel>
                                                    <apex:outputPanel rendered="{!item.hasPriceDiscrepancy}">
                                                        <span class="indicator-icon icon-price" title="Price Discrepancy">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                        </span>
                                                    </apex:outputPanel>
                                                    <apex:outputPanel rendered="{!item.record.Manual_Disable__c}">
                                                        <span class="indicator-icon icon-disabled" title="Disabled">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                                                        </span>
                                                    </apex:outputPanel>
                                                </div>
                                                <apex:outputPanel rendered="{!AND(item.record.In_R4K_Website__c, item.record.LastModifiedDate != null)}">
                                                    <span class="update-timestamp" title="Last modified: {!item.record.LastModifiedDate}">
                                                        Updated <apex:outputText value="{!FLOOR((NOW() - item.record.LastModifiedDate) * 24)}"/>h ago
                                                    </span>
                                                </apex:outputPanel>
                                            </div>
                                        </td>
                                        <td class="status-cell">
                                            <div class="cell-content">
                                                <apex:outputPanel rendered="{!item.hasPriceDiscrepancy}">
                                                    <span class="badge badge-error" title="{!item.priceAlertTooltip}">Price Alert</span>
                                                </apex:outputPanel>
                                                <!-- Price Discrepancy badge - requires controller update
                                                <apex:outputPanel rendered="{!item.hasCompetitorPriceChange}">
                                                    <span class="badge badge-price-change" title="{!item.priceChangeTooltip}">Price Discrepancy</span>
                                                </apex:outputPanel>
                                                -->
                                                <apex:outputPanel rendered="{!item.hasMissingURL}">
                                                    <span class="badge badge-warning" title="{!item.missingURLTooltip}">Missing URL</span>
                                                </apex:outputPanel>
                                                <apex:outputPanel rendered="{!item.hasSupplierError}">
                                                    <span class="badge badge-info" title="{!item.noteTooltip}">Note</span>
                                                </apex:outputPanel>
                                                <apex:outputPanel rendered="{!NOT(item.hasPriceDiscrepancy) && NOT(item.hasMissingURL) && NOT(item.hasSupplierError)}">
                                                    <span class="badge badge-success" title="All checks passed - no issues detected">OK</span>
                                                </apex:outputPanel>

                                                <!-- Website Published Status Badge -->
                                                <apex:outputPanel rendered="{!item.record.In_R4K_Website__c}">
                                                    <span class="badge badge-published"
                                                          title="{!IF(item.record.Website_Update_Status__c != null, item.record.Website_Update_Status__c, 'Published on website')}">
                                                        Published
                                                    </span>
                                                </apex:outputPanel>

                                                <!-- Recently Edited Indicator -->
                                                <apex:outputPanel rendered="{!OR(
                                                    AND(item.record.Competitor_1_Last_Updated__c != null, (NOW() - item.record.Competitor_1_Last_Updated__c) < 2),
                                                    AND(item.record.Competitor_2_Last_Updated__c != null, (NOW() - item.record.Competitor_2_Last_Updated__c) < 2),
                                                    AND(item.record.Competitor_3_Last_Updated__c != null, (NOW() - item.record.Competitor_3_Last_Updated__c) < 2),
                                                    AND(item.record.Supplier_1_Last_Updated__c != null, (NOW() - item.record.Supplier_1_Last_Updated__c) < 2),
                                                    AND(item.record.Supplier_2_Last_Updated__c != null, (NOW() - item.record.Supplier_2_Last_Updated__c) < 2)
                                                )}">
                                                    <span class="badge-recently-edited" title="Comp1: {!IF(AND(item.record.Competitor_1_Last_Updated__c != null, (NOW() - item.record.Competitor_1_Last_Updated__c) < 2), RIGHT('0' & TEXT(DAY(DATEVALUE(item.record.Competitor_1_Last_Updated__c))), 2) & '/' & RIGHT('0' & TEXT(MONTH(DATEVALUE(item.record.Competitor_1_Last_Updated__c))), 2) & '/' & TEXT(YEAR(DATEVALUE(item.record.Competitor_1_Last_Updated__c))) & ' ' & RIGHT('0' & TEXT(HOUR(TIMEVALUE(item.record.Competitor_1_Last_Updated__c))), 2) & ':' & RIGHT('0' & TEXT(MINUTE(TIMEVALUE(item.record.Competitor_1_Last_Updated__c))), 2) & ' (' & TEXT(FLOOR((NOW() - item.record.Competitor_1_Last_Updated__c) * 24)) & 'h ago)', '-')}&#10;Comp2: {!IF(AND(item.record.Competitor_2_Last_Updated__c != null, (NOW() - item.record.Competitor_2_Last_Updated__c) < 2), RIGHT('0' & TEXT(DAY(DATEVALUE(item.record.Competitor_2_Last_Updated__c))), 2) & '/' & RIGHT('0' & TEXT(MONTH(DATEVALUE(item.record.Competitor_2_Last_Updated__c))), 2) & '/' & TEXT(YEAR(DATEVALUE(item.record.Competitor_2_Last_Updated__c))) & ' ' & RIGHT('0' & TEXT(HOUR(TIMEVALUE(item.record.Competitor_2_Last_Updated__c))), 2) & ':' & RIGHT('0' & TEXT(MINUTE(TIMEVALUE(item.record.Competitor_2_Last_Updated__c))), 2) & ' (' & TEXT(FLOOR((NOW() - item.record.Competitor_2_Last_Updated__c) * 24)) & 'h ago)', '-')}&#10;Comp3: {!IF(AND(item.record.Competitor_3_Last_Updated__c != null, (NOW() - item.record.Competitor_3_Last_Updated__c) < 2), RIGHT('0' & TEXT(DAY(DATEVALUE(item.record.Competitor_3_Last_Updated__c))), 2) & '/' & RIGHT('0' & TEXT(MONTH(DATEVALUE(item.record.Competitor_3_Last_Updated__c))), 2) & '/' & TEXT(YEAR(DATEVALUE(item.record.Competitor_3_Last_Updated__c))) & ' ' & RIGHT('0' & TEXT(HOUR(TIMEVALUE(item.record.Competitor_3_Last_Updated__c))), 2) & ':' & RIGHT('0' & TEXT(MINUTE(TIMEVALUE(item.record.Competitor_3_Last_Updated__c))), 2) & ' (' & TEXT(FLOOR((NOW() - item.record.Competitor_3_Last_Updated__c) * 24)) & 'h ago)', '-')}&#10;Supp1: {!IF(AND(item.record.Supplier_1_Last_Updated__c != null, (NOW() - item.record.Supplier_1_Last_Updated__c) < 2), RIGHT('0' & TEXT(DAY(DATEVALUE(item.record.Supplier_1_Last_Updated__c))), 2) & '/' & RIGHT('0' & TEXT(MONTH(DATEVALUE(item.record.Supplier_1_Last_Updated__c))), 2) & '/' & TEXT(YEAR(DATEVALUE(item.record.Supplier_1_Last_Updated__c))) & ' ' & RIGHT('0' & TEXT(HOUR(TIMEVALUE(item.record.Supplier_1_Last_Updated__c))), 2) & ':' & RIGHT('0' & TEXT(MINUTE(TIMEVALUE(item.record.Supplier_1_Last_Updated__c))), 2) & ' (' & TEXT(FLOOR((NOW() - item.record.Supplier_1_Last_Updated__c) * 24)) & 'h ago)', '-')}&#10;Supp2: {!IF(AND(item.record.Supplier_2_Last_Updated__c != null, (NOW() - item.record.Supplier_2_Last_Updated__c) < 2), RIGHT('0' & TEXT(DAY(DATEVALUE(item.record.Supplier_2_Last_Updated__c))), 2) & '/' & RIGHT('0' & TEXT(MONTH(DATEVALUE(item.record.Supplier_2_Last_Updated__c))), 2) & '/' & TEXT(YEAR(DATEVALUE(item.record.Supplier_2_Last_Updated__c))) & ' ' & RIGHT('0' & TEXT(HOUR(TIMEVALUE(item.record.Supplier_2_Last_Updated__c))), 2) & ':' & RIGHT('0' & TEXT(MINUTE(TIMEVALUE(item.record.Supplier_2_Last_Updated__c))), 2) & ' (' & TEXT(FLOOR((NOW() - item.record.Supplier_2_Last_Updated__c) * 24)) & 'h ago)', '-')}">
                                                        Edited
                                                    </span>
                                                </apex:outputPanel>
                                            </div>
                                        </td>
                                        <td class="price-cell">
                                            <div class="price-cell-content">
                                                <apex:outputPanel rendered="{!item.record.Cash_Price__c != null}">
                                                    <div class="cash-price-value">
                                                        <apex:outputText value="${0, number, ###,##0.00}">
                                                            <apex:param value="{!item.record.Cash_Price__c}" />
                                                        </apex:outputText>
                                                    </div>
                                                </apex:outputPanel>
                                                <apex:outputPanel rendered="{!item.record.Cash_Price__c == null}">
                                                    <span class="data-missing">Not Set</span>
                                                </apex:outputPanel>

                                                <apex:outputPanel rendered="{!item.marginPercent != null}">
                                                    <div class="margin-line" title="Margin: (cash price - cheapest supplier price - metro delivery) / cash price, all including GST. Target 15-17%.">
                                                        <span>Margin</span>
                                                        <span class="margin-pill margin-{!item.marginBand}">{!item.marginDisplay}</span>
                                                    </div>
                                                </apex:outputPanel>

                                                <apex:outputPanel rendered="{!item.hasVariance}">
                                                    <div class="variance-info">
                                                        <div class="variance-prices">
                                                            <span class="variance-price-label">Supplier:</span>
                                                            <span class="variance-price-value">
                                                                <apex:outputText value="${0, number, ###,##0.00}">
