            /* Minimalist overrides - enforce neutral alert styling */
            .inventory-table tbody tr.row-has-error,
            .inventory-table tbody tr.row-price-discrepancy {
                background: #f8fafc !important;
                border-left: 3px solid #cbd5e1 !important;
