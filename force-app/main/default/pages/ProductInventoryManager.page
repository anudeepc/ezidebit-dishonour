                                                <!-- Website Actions Dropdown -->
                                                <div class="website-dropdown-wrapper">
                                                    <button class="btn-website-actions"
                                                            onclick="event.stopPropagation(); toggleWebsiteDropdown('{!item.record.Id}'); return false;"
                                                            title="Website actions">
                                                        Actions
                                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <polyline points="6 9 12 15 18 9"></polyline>
                                                        </svg>
                                                    </button>
                                                    <div class="website-dropdown-menu" id="websiteDropdown_{!item.record.Id}">
                                                        <div class="dropdown-item" onclick="event.stopPropagation(); updateWebsitePrice('{!item.record.Id}'); closeWebsiteDropdown('{!item.record.Id}');">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                                            Update Price
                                                        </div>
                                                        <!-- Availability is one toggle, so only the action that applies is offered.
                                                             Showing both let staff take an already-out-of-stock product "out of stock"
                                                             again, which reported success while changing nothing a shopper could see. -->
                                                        <apex:outputPanel rendered="{!NOT(item.record.Manual_Disable__c)}">
                                                            <div class="dropdown-item warning" onclick="event.stopPropagation(); markOutOfStock('{!item.record.Id}'); closeWebsiteDropdown('{!item.record.Id}');">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                                                Out of Stock
                                                            </div>
                                                        </apex:outputPanel>
                                                        <apex:outputPanel rendered="{!item.record.Manual_Disable__c}">
                                                            <div class="dropdown-item success" onclick="event.stopPropagation(); reactivateProduct('{!item.record.Id}'); closeWebsiteDropdown('{!item.record.Id}');">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                                                Put Back On Sale
                                                            </div>
                                                        </apex:outputPanel>
                                                        <div class="dropdown-item" onclick="event.stopPropagation(); openTermsEditor('{!item.record.Id}'); closeWebsiteDropdown('{!item.record.Id}');">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="8" y1="10" x2="16" y2="10"></line><line x1="8" y1="14" x2="13" y2="14"></line></svg>
                                                            Contract Terms
                                                        </div>
                                                        <div class="dropdown-item danger" onclick="event.stopPropagation(); disableFromWebsite('{!item.record.Id}'); closeWebsiteDropdown('{!item.record.Id}');">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                                            Disable
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Which contract terms the site offers. Only shown when it differs from the
                                                     24 + 36 default, so the column stays quiet for the thousands of products
                                                     nobody has needed to change. -->
                                                <apex:outputPanel rendered="{!item.record.Website_Terms__c != '24,36'}">
                                                    <div class="terms-badge" title="Contract terms offered on the website">
                                                        <apex:outputText value="{!item.record.Website_Terms__c}"/> mth
                                                    </div>
                                                </apex:outputPanel>

                                                <!-- Website disagreement: show both sides and let the operator choose a direction -->
                                                <apex:outputPanel rendered="{!item.record.Website_Drift__c}">
                                                    <div class="drift-panel">
                                                        <div class="drift-line">
                                                            <span class="drift-tag">Salesforce</span>
                                                            <apex:outputText rendered="{!item.record.Manual_Disable__c}">off sale</apex:outputText>
                                                            <apex:outputText rendered="{!NOT(item.record.Manual_Disable__c)}">on sale</apex:outputText>
                                                        </div>
                                                        <div class="drift-line">
                                                            <span class="drift-tag alt">Website</span>
                                                            {!item.record.Woo_Stock_Status__c}
                                                            <apex:outputText rendered="{!item.record.Woo_Post_Status__c != 'publish'}"> ({!item.record.Woo_Post_Status__c})</apex:outputText>
                                                        </div>
                                                        <div class="drift-since">
                                                            Disagreeing since <apex:outputText value="{0,date,dd/MM/yyyy HH:mm}"><apex:param value="{!item.record.Woo_Drift_Since__c}" /></apex:outputText>
                                                        </div>
                                                        <div class="drift-actions">
                                                            <button type="button" class="drift-btn fix" onclick="event.stopPropagation(); resolveFixWebsite('{!item.record.Id}');"
                                                                    title="Push the Salesforce decision to the website">Fix the website</button>
                                                            <button type="button" class="drift-btn accept" onclick="event.stopPropagation(); resolveAcceptWebsite('{!item.record.Id}');"
                                                                    title="Adopt the website's state into Salesforce">Accept the website</button>
                                                        </div>
                                                    </div>
                                                </apex:outputPanel>

                                                <!-- Website Status Badge -->
                                                <apex:outputPanel rendered="{!item.record.Website_Status__c != null}">
                                                    <span class="website-status-badge {!LOWER(item.record.Website_Status__c)}-status">
                                                        {!item.record.Website_Status__c}
                                                    </span>
                                                </apex:outputPanel>

                                                <!-- Website Update Date (compact) -->
                                                <apex:outputPanel rendered="{!item.record.Website_Update_Date__c != null}">
                                                    <span class="website-info-item compact-date">
                                                        <span class="local-datetime" data-utc="{!item.record.Website_Update_Date__c}"></span>
                                                    </span>
                                                </apex:outputPanel>

                                                <!-- Visit Website Link -->
                                                <apex:outputPanel rendered="{!item.record.Website_URL__c != null}">
