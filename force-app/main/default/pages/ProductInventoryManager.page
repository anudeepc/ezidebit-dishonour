                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       class="website-visit-link"
                                                       onclick="event.stopPropagation()"
                                                       title="Visit product page on website">
                                                        Visit Page
                                                    </a>
                                                </apex:outputPanel>
                                            </div>
                                        </td>
                                    </tr>
                                </apex:repeat>
                                </tbody>
                            </table>
                        </apex:outputPanel>

                        <apex:outputPanel rendered="{!inventoryRecords.size == 0}">
                            <div class="empty-state">
                                <div class="empty-state-icon">📦</div>
                                <h3>No records found</h3>
                                <p>Try adjusting your search criteria</p>
                            </div>
                        </apex:outputPanel>
                    </div>
                </div>

                <!-- Pagination Controls Bottom -->
                <apex:outputPanel rendered="{!totalRecords > 0}" styleClass="pagination-container" style="margin-top: 16px;">
                    <div class="pagination-info" id="paginationInfoBottom">
                        Showing <strong><span id="paginationRangeBottom">{!(pageNumber-1)*pageSize + 1}-{!MIN(pageNumber*pageSize, totalRecords)}</span></strong> of <strong><span id="paginationTotalBottom">{!totalRecords}</span></strong> products
                        <span id="filteredCountBottom" style="color: #3b82f6; font-weight: 500;"></span>
                    </div>

                    <div class="pagination-controls">
                        <apex:commandButton value="First"
                                            action="{!firstPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasPrevious)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility(); scrollToTop();" />

                        <apex:commandButton value="Previous"
                                            action="{!previousPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasPrevious)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility(); scrollToTop();" />

                        <apex:repeat value="{!pageNumbers}" var="pageNum">
                            <apex:commandButton value="{!pageNum}"
                                                action="{!goToPage}"
                                                reRender="tableContainer,paginationContainer"
                                                styleClass="pagination-btn {!IF(pageNum == pageNumber, 'active', '')}"
                                                status="loadingStatus"
                                                oncomplete="initTableAccessibility(); scrollToTop();">
                                <apex:param name="selectedPage" value="{!pageNum}" assignTo="{!pageNumber}" />
                            </apex:commandButton>
                        </apex:repeat>

                        <apex:commandButton value="Next"
                                            action="{!nextPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasNext)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility(); scrollToTop();" />

                        <apex:commandButton value="Last"
                                            action="{!lastPage}"
                                            reRender="tableContainer,paginationContainer"
                                            styleClass="pagination-btn"
                                            disabled="{!NOT(hasNext)}"
                                            status="loadingStatus"
                                            oncomplete="initTableAccessibility(); scrollToTop();" />
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <label for="pageSizeBottom" style="font-size: 14px; color: #6b7280;">Show:</label>
                        <apex:selectList id="pageSizeBottom" value="{!pageSize}" size="1" styleClass="page-size-select" onchange="handlePageSizeChange(this);">
                            <apex:selectOption itemValue="25" itemLabel="25" />
                            <apex:selectOption itemValue="50" itemLabel="50" />
                            <apex:selectOption itemValue="100" itemLabel="100" />
                            <apex:selectOption itemValue="250" itemLabel="250" />
                            <apex:selectOption itemValue="500" itemLabel="500" />
                            <apex:selectOption itemValue="1000" itemLabel="1000" />
                        </apex:selectList>
                    </div>
                </apex:outputPanel>
            </apex:outputPanel>
        </apex:form>
