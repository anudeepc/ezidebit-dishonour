<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Decline_Needs_Reasons</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Declined&apos;), OR(ISBLANK(Decline_Reasons__c), ISBLANK(Decision_Date__c)))</errorConditionFormula>
    <errorDisplayField>Decline_Reasons__c</errorDisplayField>
    <errorMessage>A declined request needs the reasons and the decision date: the decline notice must state why (NCC s72(4)).</errorMessage>
</ValidationRule>
