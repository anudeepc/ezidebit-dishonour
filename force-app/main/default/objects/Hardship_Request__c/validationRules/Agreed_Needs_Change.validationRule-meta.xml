<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Agreed_Needs_Change</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Agreed&apos;), OR(ISPICKVAL(Agreed_Change__c, &apos;&apos;), ISBLANK(Change_Start_Date__c), ISBLANK(Change_End_Date__c), ISBLANK(Decision_Date__c)))</errorConditionFormula>
    <errorDisplayField>Agreed_Change__c</errorDisplayField>
    <errorMessage>An agreed request needs the change, its start and end dates, and the decision date.</errorMessage>
</ValidationRule>
